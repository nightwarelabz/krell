}

; Wrap an angle to [-pi, pi].
fn wrapa(f64) -> f64 {
  entry(a: f64):
    %tw = fdiv f64 a, 6.283185307179586
    %ti = fptosi i64 %tw
    %tf = sitofp f64 %ti
    %w = fma f64 -6.283185307179586, %tf, a
    %over = fcmp.ogt f64 %w, 3.141592653589793
    %w2a = fadd f64 %w, -6.283185307179586
    %w2 = select f64 %over, %w2a, %w
    %under = fcmp.olt f64 %w2, -3.141592653589793
    %w3a = fadd f64 %w2, 6.283185307179586
    %w3 = select f64 %under, %w3a, %w2
    ret %w3
}

; Cosine by the sine polynomial on the shifted angle.
fn kcos(f64) -> f64 {
  entry(a: f64):
    %s = fadd f64 a, 1.5707963267948966
    %w = call f64 wrapa(%s)
    %r = call f64 ksin(%w)
    ret %r
}

; Contribution of phasor k at time t. Writes (dx, dy) to out.
fn phasor_at(ptr, ptr, i64, f64, ptr) -> void {
  entry(tf: ptr, ti: ptr, k: i64, t: f64, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %fa = gep i64 ti, k
    %f = load i64, %fa
    %ff = sitofp f64 %f
    %aa = gep f64 tf, k
    %amp = load f64, %aa
    %k2 = add i64 k, 1024
    %pa = gep f64 tf, %k2
    %ph = load f64, %pa
    %w0 = fmul f64 %ff, t
    %w1 = fmul f64 %w0, 6.283185307179586
    %a0 = fadd f64 %w1, %ph
    %a = call f64 wrapa(%a0)
    %sv = call f64 ksin(%a)
    %cv = call f64 kcos(%a)
    %dx = fmul f64 %amp, %cv
    %dy = fmul f64 %amp, %sv
    %o0 = gep f64 out, 0
    store f64 %o0, %dx
    %o1 = gep f64 out, 1
    store f64 %o1, %dy
    ret
}

; The full sum at time t: the pen point. Writes (x, y) to out.
fn phasor_sum(ptr, ptr, f64, ptr, ptr) -> void {
  entry(tf: ptr, ti: ptr, t: f64, tmp: ptr, out: ptr):
    %one = iconst i64 1
    br loop(0, 0.0, 0.0, tf, ti, t, tmp, out)
  loop(k: i64, sx: f64, sy: f64, tf: ptr, ti: ptr, t: f64, tmp: ptr, out: ptr):
    %done = icmp.sge i64 k, 1024
    condbr %done, fin(%sx, %sy, out), body(k, sx, sy, tf, ti, t, tmp, out)
  body(k: i64, sx: f64, sy: f64, tf: ptr, ti: ptr, t: f64, tmp: ptr, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    call void phasor_at(tf, ti, k, t, tmp)
    %a0 = gep f64 tmp, 0
    %dx = load f64, %a0
    %a1 = gep f64 tmp, 1
    %dy = load f64, %a1
    %sx2 = fadd f64 sx, %dx
    %sy2 = fadd f64 sy, %dy
    %k2 = add i64 k, 1
    br loop(%k2, %sx2, %sy2, tf, ti, t, tmp, out)
  fin(sx: f64, sy: f64, out: ptr):
    %o0 = gep f64 out, 0
    store f64 %o0, %sx
    %o1 = gep f64 out, 1
    store f64 %o1, %sy
    ret
}

; Canvas conversion with clamping: v in [0,1] -> pixel index.
fn topix(f64, f64, i64) -> i64 {
  entry(v: f64, fs: f64, S: i64):
    %m = fma f64 v, 0.88, 0.06
    %p = fmul f64 %m, fs
    %i = fptosi i64 %p
    %lo = icmp.slt i64 %i, 1
    %i1 = select i64 %lo, 1, %i
    %max = sub i64 S, 2
    %hi = icmp.sgt i64 %i1, %max
    %i2 = select i64 %hi, %max, %i1
    ret %i2
}

; A soft stamp: 3x3 kernel into buf at (ix, iy), weight w.
fn splat(ptr, i64, i64, i64, f64) -> void {
  entry(buf: ptr, S: i64, ix: i64, iy: i64, w: f64):
    %row = mul i64 iy, S
    %c = add i64 %row, ix
    %wm = sub i64 %c, S
    %wp = add i64 %c, S
    %w42 = fmul f64 w, 0.42
    %w20 = fmul f64 w, 0.20
    %a0 = gep f64 buf, %c
    %v0 = load f64, %a0
    %n0 = fadd f64 %v0, w
    store f64 %a0, %n0
    %c1 = sub i64 %c, 1
    %a1 = gep f64 buf, %c1
    %v1 = load f64, %a1
    %n1 = fadd f64 %v1, %w42
    store f64 %a1, %n1
    %c2 = add i64 %c, 1
    %a2 = gep f64 buf, %c2
    %v2 = load f64, %a2
    %n2 = fadd f64 %v2, %w42
    store f64 %a2, %n2
    %c3 = sub i64 %wm, 1
    %a3 = gep f64 buf, %c3
    %v3 = load f64, %a3
    %n3 = fadd f64 %v3, %w20
    store f64 %a3, %n3
    %a4 = gep f64 buf, %wm
    %v4 = load f64, %a4
    %n4 = fadd f64 %v4, %w42
    store f64 %a4, %n4
    %c5 = add i64 %wm, 1
    %a5 = gep f64 buf, %c5
    %v5 = load f64, %a5
    %n5 = fadd f64 %v5, %w20
    store f64 %a5, %n5
    %c6 = sub i64 %wp, 1
    %a6 = gep f64 buf, %c6
    %v6 = load f64, %a6
    %n6 = fadd f64 %v6, %w20
    store f64 %a6, %n6
    %a7 = gep f64 buf, %wp
    %v7 = load f64, %a7
    %n7 = fadd f64 %v7, %w42
    store f64 %a7, %n7
    %c8 = add i64 %wp, 1
    %a8 = gep f64 buf, %c8
    %v8 = load f64, %a8
    %n8 = fadd f64 %v8, %w20
    store f64 %a8, %n8
    ret
}

; One wheel: the circle of radius r around (cx, cy) in outline
; coordinates (y up), drawn with n samples at weight w so a
; wheel of any size reads at the same faintness.
fn draw_circle(ptr, i64, f64, f64, f64, f64, i64, f64) -> void {
  entry(buf: ptr, S: i64, fs: f64, cx: f64, cy: f64, r: f64, n: i64, w: f64):
    %one = iconst i64 1
    %fn = sitofp f64 n
    %step = fdiv f64 6.283185307179586, %fn
    br loop(0, buf, S, fs, cx, cy, r, n, w, %step)
  loop(m: i64, buf: ptr, S: i64, fs: f64, cx: f64, cy: f64, r: f64, n: i64, w: f64, step: f64):
    %done = icmp.sge i64 m, n
    condbr %done, fin(), body(m, buf, S, fs, cx, cy, r, n, w, step)
  body(m: i64, buf: ptr, S: i64, fs: f64, cx: f64, cy: f64, r: f64, n: i64, w: f64, step: f64):
    %fm = sitofp f64 m
    %a0 = fmul f64 %fm, step
    %a = call f64 wrapa(%a0)
    %sv = call f64 ksin(%a)
    %cv = call f64 kcos(%a)
    %x = fma f64 r, %cv, cx
    %yv = fma f64 r, %sv, cy
    %yd = fsub f64 1.0, %yv
    %ix = call i64 topix(%x, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, w)
    %m2 = add i64 m, 1
    br loop(%m2, buf, S, fs, cx, cy, r, n, w, step)
  fin():
    ret
}

; One arm: the segment from (x0, y0) to (x1, y1), outline coords.
fn draw_seg(ptr, i64, f64, f64, f64, f64, f64) -> void {
  entry(buf: ptr, S: i64, fs: f64, x0: f64, y0: f64, x1: f64, y1: f64):
    %one = iconst i64 1
    br loop(0, buf, S, fs, x0, y0, x1, y1)
  loop(m: i64, buf: ptr, S: i64, fs: f64, x0: f64, y0: f64, x1: f64, y1: f64):
    %done = icmp.sge i64 m, 48
    condbr %done, fin(), body(m, buf, S, fs, x0, y0, x1, y1)
  body(m: i64, buf: ptr, S: i64, fs: f64, x0: f64, y0: f64, x1: f64, y1: f64):
    %fm = sitofp f64 m
    %u = fmul f64 %fm, 0.020833333333333332
    %dx = fsub f64 x1, x0
    %x = fma f64 %dx, %u, x0
    %dy = fsub f64 y1, y0
    %yv = fma f64 %dy, %u, y0
    %yd = fsub f64 1.0, %yv
    %ix = call i64 topix(%x, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, 0.22)
    %m2 = add i64 m, 1
    br loop(%m2, buf, S, fs, x0, y0, x1, y1)
  fin():
    ret
}

; The wheels at time t: chain the phasors head to tail and
; draw every wheel whose amplitude exceeds 0.012, its arm,
; and a dot at each joint and at the pen.
fn wheels_t(ptr, ptr, ptr, ptr, i64, f64, f64) -> void {
  entry(tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %onef = fmul f64 1.0, 1.0
    call void phasor_at(tf, ti, 0, t, tmp)
    %a0 = gep f64 tmp, 0
    %cx0 = load f64, %a0
    %a1 = gep f64 tmp, 1
    %cy0 = load f64, %a1
    br loop(1, %cx0, %cy0, tf, ti, tmp, buf, S, fs, t)
  loop(j: i64, px: f64, py: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64):
    %done = icmp.sge i64 j, 1024
    condbr %done, fin(%px, %py, buf, S, fs), body(j, px, py, tf, ti, tmp, buf, S, fs, t)
  body(j: i64, px: f64, py: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %aa = gep f64 tf, j
    %amp = load f64, %aa
    %big = fcmp.ogt f64 %amp, 0.012
    condbr %big, draw(j, px, py, tf, ti, tmp, buf, S, fs, t, %amp), skip(j, px, py, tf, ti, tmp, buf, S, fs, t)
  draw(j: i64, px: f64, py: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64, amp: f64):
    %circ = fmul f64 amp, fs
    %circ2 = fmul f64 %circ, 8.377580409572781
    %nci = fptosi i64 %circ2
    %nlo = icmp.slt i64 %nci, 120
    %nc1 = select i64 %nlo, 120, %nci
    %nhi = icmp.sgt i64 %nc1, 4000
    %nc = select i64 %nhi, 4000, %nc1
    call void draw_circle(buf, S, fs, px, py, amp, %nc, 0.30)
    call void phasor_at(tf, ti, j, t, tmp)
    %a0 = gep f64 tmp, 0
    %dx = load f64, %a0
    %a1 = gep f64 tmp, 1
    %dy = load f64, %a1
    %nx = fadd f64 px, %dx
    %ny = fadd f64 py, %dy
    call void draw_seg(buf, S, fs, px, py, %nx, %ny)
    %yd = fsub f64 1.0, py
    %ix = call i64 topix(px, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, 0.5)
    br loop2(j, %nx, %ny, tf, ti, tmp, buf, S, fs, t)
  skip(j: i64, px: f64, py: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64):
    call void phasor_at(tf, ti, j, t, tmp)
    %a0 = gep f64 tmp, 0
    %dx = load f64, %a0
    %a1 = gep f64 tmp, 1
    %dy = load f64, %a1
    %nx = fadd f64 px, %dx
    %ny = fadd f64 py, %dy
    br loop2(j, %nx, %ny, tf, ti, tmp, buf, S, fs, t)
  loop2(j: i64, px: f64, py: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, t: f64):
    %j2 = add i64 j, 1
    br loop(%j2, px, py, tf, ti, tmp, buf, S, fs, t)
  fin(px: f64, py: f64, buf: ptr, S: i64, fs: f64):
    %yd = fsub f64 1.0, py
    %ix = call i64 topix(px, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, 0.8)
    ret
}

; The eye: a short slanted stroke of red at the mare's gaze,
; stamped tight for the core and wide for the halo. Its place
; is not chosen by eye: it is measured from the reference
; photograph's own red pixels (266 of them, one cluster) -
; centroid (0.7781, 0.4798), axis from (0.7686, 0.5033) to
; (0.7876, 0.4563), in outline coordinates.
fn draw_eye(ptr, i64, f64) -> void {
  entry(buf: ptr, S: i64, fs: f64):
    %one = iconst i64 1
    %onef = fmul f64 1.0, 1.0
    %e375 = fmul f64 0.375, 1.0
    %e927 = fmul f64 0.927, 1.0
    br core(0, 9753132461154321, buf, S, fs)
  core(m: i64, st: i64, buf: ptr, S: i64, fs: f64):
    %done = icmp.sge i64 m, 300
    condbr %done, halo(0, st, buf, S, fs), cbody(m, st, buf, S, fs)
  cbody(m: i64, st: i64, buf: ptr, S: i64, fs: f64):
    %s1 = call i64 rng(st)
    %u1 = call f64 unif(%s1)
    %s2 = call i64 rng(%s1)
    %u2 = call f64 unif(%s2)
    %x0 = fma f64 0.019, %u1, 0.7686
    %j0 = fma f64 0.009, %u2, -0.0045
    %jx = fmul f64 %j0, 0.927
    %x = fadd f64 %x0, %jx
    %y0 = fma f64 -0.047, %u1, 0.5033
    %jy = fmul f64 %j0, 0.375
    %yv = fadd f64 %y0, %jy
    %yd = fsub f64 1.0, %yv
    %ix = call i64 topix(%x, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, 0.85)
    %m2 = add i64 m, 1
    br core(%m2, %s2, buf, S, fs)
  halo(m: i64, st: i64, buf: ptr, S: i64, fs: f64):
    %done = icmp.sge i64 m, 700
    condbr %done, fin(), hbody(m, st, buf, S, fs)
  hbody(m: i64, st: i64, buf: ptr, S: i64, fs: f64):
    %s1 = call i64 rng(st)
    %u1 = call f64 unif(%s1)
    %s2 = call i64 rng(%s1)
    %u2 = call f64 unif(%s2)
    %a1 = fma f64 0.034, %u1, -0.017
    %b1 = fma f64 0.013, %u2, -0.0065
    %x0 = fma f64 0.375, %a1, 0.7781
    %x = fma f64 0.927, %b1, %x0
    %y0 = fma f64 -0.927, %a1, 0.4798
    %yv = fma f64 0.375, %b1, %y0
    %yd = fsub f64 1.0, %yv
    %ix = call i64 topix(%x, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, 0.10)
    %m2 = add i64 m, 1
    br halo(%m2, %s2, buf, S, fs)
  fin():
    ret
}

fn sstep(f64) -> f64 {
  entry(x: f64):
    %a = fmul f64 x, x
    %b = fma f64 -2.0, x, 3.0
    %r = fmul f64 %a, %b
    ret %r
}

; Stamp the eye once, when the flag says the moment has come.
fn maybe_eye(ptr, i64, f64, i64) -> void {
  entry(buf: ptr, S: i64, fs: f64, flag: i64):
    %yes = icmp.ne i64 flag, 0
    condbr %yes, do(buf, S, fs), no()
  do(buf: ptr, S: i64, fs: f64):
    call void draw_eye(buf, S, fs)
    ret
  no():
    ret
}

; A range of the trace: pen positions from..to of 120000,
; stamped at weight w into buf. A no-op when to <= from. Run
; the full range and the outline is the Fourier sum itself.
fn stamp_range(ptr, ptr, ptr, ptr, i64, f64, i64, i64, f64) -> void {
  entry(tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, from: i64, to: i64, w: f64):
    %one = iconst i64 1
    %out = call ptr malloc(16)
    br loop(from, to, w, tf, ti, tmp, buf, S, fs, %out)
  loop(i: i64, to: i64, w: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, out: ptr):
    %done = icmp.sge i64 i, to
    condbr %done, fin(%out), body(i, to, w, tf, ti, tmp, buf, S, fs, out)
  body(i: i64, to: i64, w: f64, tf: ptr, ti: ptr, tmp: ptr, buf: ptr, S: i64, fs: f64, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %fi = sitofp f64 i
    %t = fmul f64 %fi, 0.000008333333333333334
    call void phasor_sum(tf, ti, %t, tmp, out)
    %a0 = gep f64 out, 0
    %x = load f64, %a0
    %a1 = gep f64 out, 1
    %yv = load f64, %a1
    %yd = fsub f64 1.0, %yv
    %ix = call i64 topix(%x, fs, S)
    %iy = call i64 topix(%yd, fs, S)
    call void splat(buf, S, %ix, %iy, w)
    %i2 = add i64 i, 1
    br loop(%i2, to, w, tf, ti, tmp, buf, S, fs, out)
  fin(out: ptr):
    call void free(out)
    ret
}

fn zero(ptr, i64) -> void {
  entry(buf: ptr, np: i64):
    %one = iconst i64 1
    br loop(0, buf, np)
  loop(i: i64, buf: ptr, np: i64):
    %done = icmp.sge i64 i, np
    condbr %done, fin(), body(i, buf, np)
  body(i: i64, buf: ptr, np: i64):
    %a = gep f64 buf, i
    store f64 %a, 0.0
    %i2 = add i64 i, 1
    br loop(%i2, buf, np)
  fin():
    ret
}

; Tonemap and pack for the film: the accumulated trace, the
; live machinery at half strength, the ghost of the whole
; outline underneath at a whisper, and the eye under its
; ignition gain.
fn shade2(ptr, ptr, ptr, ptr, ptr, i64, i64, f64) -> void {
  entry(Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, rgain: f64):
    %one = iconst i64 1
    br loop(0, Lt, Lm, Lg, R, buf, S, np, rgain)
  loop(idx: i64, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, rgain: f64):
    %done = icmp.sge i64 idx, np
    condbr %done, fin(), body(idx, Lt, Lm, Lg, R, buf, S, np, rgain)
  body(idx: i64, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, rgain: f64):
    %at = gep f64 Lt, idx
    %lt = load f64, %at
    %am = gep f64 Lm, idx
    %lm = load f64, %am
    %ag = gep f64 Lg, idx
    %lg = load f64, %ag
    %l0 = fma f64 0.55, %lm, %lt
    %l = fma f64 0.015, %lg, %l0
    %ar = gep f64 R, idx
    %rv = load f64, %ar
    %r = fmul f64 %rv, rgain
    %ld = fadd f64 %l, 1.5
    %gl = fdiv f64 %l, %ld
    %rd = fadd f64 %r, 1.4
    %gr = fdiv f64 %r, %rd
    %gw0 = fmul f64 %gr, %gr
    %gw = fmul f64 %gw0, %gr
    %gww = fmul f64 %gw, 0.9
    %rr0 = fmul f64 %gl, 0.72
    %rr1 = fma f64 1.6, %gr, %rr0
    %rr = fadd f64 %rr1, %gww
    %gg0 = fmul f64 %gl, 0.82
    %gg1 = fma f64 0.16, %gr, %gg0
    %gg = fadd f64 %gg1, %gww
    %bb0 = fmul f64 %gl, 1.0
    %bb1 = fma f64 0.05, %gr, %bb0
    %bb = fadd f64 %bb1, %gww
    %rc = call f64 clamp01(%rr)
    %gc = call f64 clamp01(%gg)
    %bc = call f64 clamp01(%bb)
    %wr = fmul f64 %rc, 255.0
    %rb = fptosi i32 %wr
    %wg = fmul f64 %gc, 255.0
    %gb = fptosi i32 %wg
    %wb = fmul f64 %bc, 255.0
    %bbv = fptosi i32 %wb
    %a255 = iconst i32 255
    %sh1 = shl i32 %a255, 24
    %sh2 = shl i32 %bbv, 16
    %sh3 = shl i32 %gb, 8
    %pk0 = or i32 %sh1, %sh2
    %pk1 = or i32 %pk0, %sh3
    %pack = or i32 %pk1, %rb
    %addr = gep i32 buf, idx
    store i32 %addr, %pack
    %idx2 = add i64 idx, 1
    br loop(%idx2, Lt, Lm, Lg, R, buf, S, np, rgain)
  fin():
    ret
}

; The film. The trace accumulates frame over frame into Lt;
; the machinery is redrawn live into Lm each frame; the whole
; outline waits underneath as a ghost in Lg; the eye ignites
; when the pen closes the loop and the machine idles on,
; slowly re-tracing its own first arc.
fn frames(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr, i64, i64, f64, i64, i64) -> void {
  entry(tf: ptr, ti: ptr, tmp: ptr, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, fs: f64, F: i64, osz: i64):
    %one = iconst i64 1
    call void stamp_range(tf, ti, tmp, Lg, S, fs, 0, 120000, 0.5)
    br loop(0, 0, 0, 0, tf, ti, tmp, Lt, Lm, Lg, R, buf, S, np, fs, F, osz)
  loop(f: i64, prevN: i64, prevI: i64, eyedone: i64, tf: ptr, ti: ptr, tmp: ptr, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, fs: f64, F: i64, osz: i64):
    %done = icmp.sge i64 f, F
    condbr %done, fin(), body(f, prevN, prevI, eyedone, tf, ti, tmp, Lt, Lm, Lg, R, buf, S, np, fs, F, osz)
  body(f: i64, prevN: i64, prevI: i64, eyedone: i64, tf: ptr, ti: ptr, tmp: ptr, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, fs: f64, F: i64, osz: i64):
    %ff = sitofp f64 f
    %un0 = fdiv f64 %ff, 180.0
    %un = call f64 clamp01(%un0)
    %pe = call f64 sstep(%un)
    %pn = fmul f64 %pe, 120000.0
    %N = fptosi i64 %pn
    call void stamp_range(tf, ti, tmp, Lt, S, fs, prevN, %N, 0.5)
    %fd = sub i64 f, 180
    %fdp = icmp.sgt i64 %fd, 0
    %fdz = select i64 %fdp, %fd, 0
    %fdf = sitofp f64 %fdz
    %delta = fmul f64 %fdf, 0.0009
    %pi2 = fmul f64 %delta, 120000.0
    %I = fptosi i64 %pi2
    call void stamp_range(tf, ti, tmp, Lt, S, fs, prevI, %I, 0.05)
    %tpen = fadd f64 %pe, %delta
    call void zero(Lm, np)
    call void wheels_t(tf, ti, tmp, Lm, S, fs, %tpen)
    %eyeT = icmp.sge i64 f, 170
    %eyeF = select i64 %eyeT, 1, 0
    %notyet = icmp.eq i64 eyedone, 0
    %nye = zext i64 %notyet
    %doeye = mul i64 %eyeF, %nye
    call void maybe_eye(R, S, fs, %doeye)
    %ed2 = select i64 %eyeT, 1, eyedone
    %rg0 = fsub f64 %ff, 170.0
    %rg1 = fdiv f64 %rg0, 40.0
    %rgain = call f64 clamp01(%rg1)
    call void shade2(Lt, Lm, Lg, R, buf, S, np, %rgain)
    %wr = call i64 write(1, buf, osz)
    %f2 = add i64 f, 1
    br loop(%f2, %N, %I, %ed2, tf, ti, tmp, Lt, Lm, Lg, R, buf, S, np, fs, F, osz)
  fin():
    ret
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %one = iconst i64 1
    %z32 = iconst i32 0
    %o32 = iconst i32 1
    %tf = call ptr malloc(16384)
    %ti = call ptr malloc(8192)
    %tmp = call ptr malloc(16)
    %pt = bitcast i64 %tf
    %ok = icmp.ne i64 %pt, 0
    condbr %ok, args(%tf, %ti, %tmp, argc, argv), fail()
  args(tf: ptr, ti: ptr, tmp: ptr, argc: i32, argv: ptr):
    %has = icmp.sgt i32 argc, 1
    condbr %has, arg1(tf, ti, tmp, argv, argc), noarg(288, 1200, tf, ti, tmp)
  arg1(tf: ptr, ti: ptr, tmp: ptr, argv: ptr, argc: i32):
    %p = gep ptr argv, 1
    %s = load ptr, %p
    %fv = call i32 atoi(%s)
    %has2 = icmp.sgt i32 argc, 2
    condbr %has2, arg2(%fv, tf, ti, tmp, argv), noarg(%fv, 1200, tf, ti, tmp)
  arg2(fv: i32, tf: ptr, ti: ptr, tmp: ptr, argv: ptr):
    %ob = bitcast i64 argv
    %ob2 = add i64 %ob, 16
    %p = bitcast ptr %ob2
    %s = load ptr, %p
    %sv = call i32 atoi(%s)
    br noarg(%fv, %sv, tf, ti, tmp)
  noarg(fv: i32, sv: i32, tf: ptr, ti: ptr, tmp: ptr):
    %flo = icmp.slt i32 fv, 24
    %f1 = select i32 %flo, 24, fv
    %fhi = icmp.sgt i32 %f1, 480
    %fv2 = select i32 %fhi, 480, %f1
    %F = sext i64 %fv2
    %slo = icmp.slt i32 sv, 200
    %s1 = select i32 %slo, 200, sv
    %shi = icmp.sgt i32 %s1, 1600
    %sv2 = select i32 %shi, 1600, %s1
    %S = sext i64 %sv2
    %np = mul i64 %S, %S
    %fs = sitofp f64 %S
    %bsz = mul i64 %np, 8
    %Lt = call ptr malloc(%bsz)
    %Lm = call ptr malloc(%bsz)
    %Lg = call ptr malloc(%bsz)
    %R = call ptr malloc(%bsz)
    %osz = mul i64 %np, 4
    %buf = call ptr malloc(%osz)
    %pb = bitcast i64 %Lt
    %okb = icmp.ne i64 %pb, 0
    condbr %okb, run(%tf, %ti, %tmp, %Lt, %Lm, %Lg, %R, %buf, %S, %np, %fs, %F, %osz), fail()
  run(tf: ptr, ti: ptr, tmp: ptr, Lt: ptr, Lm: ptr, Lg: ptr, R: ptr, buf: ptr, S: i64, np: i64, fs: f64, F: i64, osz: i64):
    call void load_table(tf, ti)
    call void zero(Lt, np)
    call void zero(Lm, np)
    call void zero(Lg, np)
    call void zero(R, np)
    call void frames(tf, ti, tmp, Lt, Lm, Lg, R, buf, S, np, fs, F, osz)
    call void free(Lt)
    call void free(Lm)
    call void free(Lg)
    call void free(R)
    call void free(buf)
    call void free(tf)
    call void free(ti)
    call void free(tmp)
    ret 0
  fail():
    ret 1
}

