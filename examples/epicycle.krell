; EPICYCLE
; The NIGHTWARE LABZ mare, drawn by harmonics.
;
; The mark is not drawn by hand and not textured onto a shape.
; It is the sum of 1024 rotating vectors: the discrete Fourier
; series of the mare's own outline. Each phasor turns at an
; integer frequency; their tip, added head to tail, traces the
; silhouette exactly, the way a Fourier series becomes the
; curve it describes. The great wheel (frequency 1, amplitude
; 0.33) carries the gesture; the smaller wheels carve the mane
; spikes, the ears, the muzzle.
;
; This is the film of that drawing. The wheels turn live,
; chained head to tail, and the pen lays the mare down arc by
; arc over a ghost of the whole. When the pen closes the loop
; the eye ignites, the one warm point, and the machine idles
; on, slowly re-tracing the first arc it ever drew.
;
; Host services: write, atoi, malloc, free. Nothing else
; computes. Output is a stream of raw RGBA frames on stdout,
; one per frame, no header.
;
; main: [frames] [size]  frames default 288, clamped
;                        24..480; size default 1200,
;                        clamped to 200..1600

extern write(i32, ptr, i64) -> i64
extern atoi(ptr) -> i32
extern malloc(i64) -> ptr
extern free(ptr) -> void

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn ksin(f64) -> f64 {
  entry(x: f64):
    %x2 = fmul f64 x, x
    %c0 = fma f64 0.0000027557319223985893, %x2, -0.00019841269841269842
    %c1 = fma f64 %c0, %x2, 0.008333333333333334
    %c2 = fma f64 %c1, %x2, -0.16666666666666666
    %c3 = fma f64 %c2, %x2, 1.0
    %r = fmul f64 %c3, x
    ret %r
}

fn rng(i64) -> i64 {
  entry(s: i64):
    %a = shl i64 s, 13
    %b = xor i64 s, %a
    %c = lshr i64 %b, 7
    %d = xor i64 %b, %c
    %e = shl i64 %d, 17
    %f = xor i64 %d, %e
    ret %f
}

fn unif(i64) -> f64 {
  entry(s: i64):
    %t = lshr i64 s, 11
    %u = uitofp f64 %t
    %r = fmul f64 %u, 0.00000000000000011102230246251565
    ret %r
}

; The phasor table: 1024 rows of (frequency, amplitude, phase),
; the Fourier coefficients of the mare's outline, amplitude
; order. Frequencies in ti[0..1023], amplitudes in tf[0..1023],
; phases in tf[1024..2047].
fn load_table(ptr, ptr) -> void {
