; GYRE
; A real Mandelbrot, turning.
;
; Not a portrait and not a sampling: every pixel runs the true
; iteration z -> z^2 + c to escape or to the frame's iteration
; limit, with the exact cardioid and bulb tests clearing the
; interior. The camera dives geometrically from the whole set
; (half width 1.6) to a half width of 5e-7, a zoom of about three
; million, aimed at a spiral in the seahorse valley, while the
; view plane rotates one full turn over the film: a gyroscope
; falling into the set.
;
; Colour is the smooth escape count, nu = n + 1 - log2(log2|z|),
; run through a cyclic palette that drifts slowly as the dive
; deepens. Krell has no logarithm and no trigonometry, so both are
; derived: klog2 reads the exponent out of the float's bits and
; finishes the mantissa with an atanh series; ksin is a Taylor
; polynomial, and the rotation matrix is built from it.
;
; Host services: write, atoi, malloc, free. Nothing else computes.
; Output is raw RGBA frames, 1280 x 720, on stdout.
;
; main: [frames]  frame count, default 288 (12 s at 24 fps),
;                 clamped to 1..600

extern write(i32, ptr, i64) -> i64
extern atoi(ptr) -> i32
extern malloc(i64) -> ptr
extern free(ptr) -> void

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn ksqrt(f64) -> f64 {
  entry(a: f64):
    %neg = fcmp.olt f64 a, 0.0
    %ac = select f64 %neg, 0.0, a
    %big = fcmp.ogt f64 %ac, 1.0
    %seed = select f64 %big, %ac, 1.0
    br it(6, %seed, %ac)
  it(n: i64, x: f64, a: f64):
    %q = fdiv f64 a, x
    %s = fadd f64 x, %q
    %x2 = fmul f64 %s, 0.5
    %n2 = sub i64 n, 1
    %more = icmp.sgt i64 %n2, 0
    condbr %more, it(%n2, %x2, a), done(%x2, a)
  done(x: f64, a: f64):
    %zero = fcmp.oeq f64 a, 0.0
    %r = select f64 %zero, 0.0, x
    ret %r
}

; Sine on [-pi, pi] by Taylor polynomial, Horner form.
fn ksin(f64) -> f64 {
  entry(x: f64):
    %x2 = fmul f64 x, x
    %c0 = fma f64 0.0000027557319223985893, %x2, -0.00019841269841269842
    %c1 = fma f64 %c0, %x2, 0.008333333333333334
    %c2 = fma f64 %c1, %x2, -0.16666666666666666
    %c3 = fma f64 %c2, %x2, 1.0
    %r = fmul f64 %c3, x
    ret %r
}

; log2(x) for x > 0: the exponent comes out of the float's own
; bits; the mantissa in [1, 2) is finished with the atanh series
; ln(m) = 2s (1 + s^2/3 + s^4/5 + s^6/7 + s^8/9), s = (m-1)/(m+1).
fn klog2(f64) -> f64 {
  entry(x: f64):
    %bits = bitcast i64 x
    %eb = lshr i64 %bits, 52
    %ee = and i64 %eb, 2047
    %e = sub i64 %ee, 1023
    %ef = sitofp f64 %e
    %mb = and i64 %bits, 4503599627370495
    %m1b = or i64 %mb, 4607182418800017408
    %m = bitcast f64 %m1b
    %sn = fsub f64 %m, 1.0
    %sd = fadd f64 %m, 1.0
    %s = fdiv f64 %sn, %sd
    %s2 = fmul f64 %s, %s
    %h0 = fma f64 0.1111111111111111, %s2, 0.14285714285714285
    %h1 = fma f64 %h0, %s2, 0.2
    %h2 = fma f64 %h1, %s2, 0.3333333333333333
    %h3 = fma f64 %h2, %s2, 1.0
    %ln = fmul f64 %s, %h3
    %ln2 = fadd f64 %ln, %ln
    %frac = fmul f64 %ln2, 1.4426950408889634
    %r = fadd f64 %ef, %frac
    ret %r
}

; Cyclic palette over ph in [0, 46): indigo, electric blue,
; cyan white, gold, magma, and back to indigo.
; Writes r, g, b as f64 in [0, 1] to out[0..2].
fn palette(f64, ptr) -> void {
  entry(ph: f64, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %g2 = iconst i64 2
    %u = fmul f64 ph, 0.021739130434782608
    %m1 = fmul f64 %u, 4.545454545454546
    %f1 = call f64 clamp01(%m1)
    %s2 = fsub f64 %u, 0.22
    %m2 = fmul f64 %s2, 4.347826086956522
    %f2 = call f64 clamp01(%m2)
    %s3 = fsub f64 %u, 0.45
    %m3 = fmul f64 %s3, 5.882352941176471
    %f3 = call f64 clamp01(%m3)
    %s4 = fsub f64 %u, 0.62
    %m4 = fmul f64 %s4, 5.555555555555556
    %f4 = call f64 clamp01(%m4)
    %s5 = fsub f64 %u, 0.8
    %m5 = fmul f64 %s5, 5.0
    %f5 = call f64 clamp01(%m5)
    %r0 = fma f64 0.01, %f1, 0.04
    %gc0 = fma f64 0.23, %f1, 0.02
    %b0 = fma f64 0.73, %f1, 0.12
    %r1d = fsub f64 0.55, %r0
    %r1 = fma f64 %r1d, %f2, %r0
    %g1d = fsub f64 0.95, %gc0
    %g1v = fma f64 %g1d, %f2, %gc0
    %b1d = fsub f64 1.0, %b0
    %b1 = fma f64 %b1d, %f2, %b0
    %r2d = fsub f64 1.0, %r1
    %r2 = fma f64 %r2d, %f3, %r1
    %g2d = fsub f64 0.75, %g1v
    %g2 = fma f64 %g2d, %f3, %g1v
    %b2d = fsub f64 0.25, %b1
    %b2 = fma f64 %b2d, %f3, %b1
    %r3d = fsub f64 0.85, %r2
    %r3 = fma f64 %r3d, %f4, %r2
    %g3d = fsub f64 0.25, %g2
    %g3 = fma f64 %g3d, %f4, %g2
    %b3d = fsub f64 0.05, %b2
    %b3 = fma f64 %b3d, %f4, %b2
    %r4d = fsub f64 0.04, %r3
    %r4 = fma f64 %r4d, %f5, %r3
    %g4d = fsub f64 0.02, %g3
    %g4 = fma f64 %g4d, %f5, %g3
    %b4d = fsub f64 0.12, %b3
    %b4 = fma f64 %b4d, %f5, %b3
    %a0 = gep f64 out, 0
    store f64 %a0, %r4
    %a1 = gep f64 out, 1
    store f64 %a1, %g4
    %a2 = gep f64 out, 2
    store f64 %a2, %b4
    ret
}

; One pixel of the true set. (cr, ci, iteration limit, palette
; drift, out) — writes r, g, b to out[0..2]; the interior is black.
fn shade(f64, f64, i64, f64, ptr) -> void {
  entry(cr: f64, ci: f64, mi: i64, drift: f64, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %g2 = iconst i64 2
    %xm = fadd f64 cr, -0.25
    %q0a = fmul f64 %xm, %xm
    %q0b = fmul f64 ci, ci
    %q0 = fadd f64 %q0a, %q0b
    %q1a = fadd f64 %q0, %xm
    %q1 = fmul f64 %q0, %q1a
    %rhs = fmul f64 0.25, %q0b
    %inc = fcmp.ole f64 %q1, %rhs
    %xp = fadd f64 cr, 1.0
    %b0a = fmul f64 %xp, %xp
    %b0 = fadd f64 %b0a, %q0b
    %inb = fcmp.ole f64 %b0, 0.0625
    %inside = or i1 %inc, %inb
    condbr %inside, black(out), iter(0, 0.0, 0.0, cr, ci, mi, drift, out)
  black(out: ptr):
    %a0 = gep f64 out, 0
    store f64 %a0, 0.0
    %a1 = gep f64 out, 1
    store f64 %a1, 0.0
    %a2 = gep f64 out, 2
    store f64 %a2, 0.0
    ret
  iter(n: i64, zr: f64, zi: f64, cr: f64, ci: f64, mi: i64, drift: f64, out: ptr):
    %z2a = fmul f64 zr, zr
    %z2b = fmul f64 zi, zi
    %m2 = fadd f64 %z2a, %z2b
    %esc = fcmp.ogt f64 %m2, 4.0
    condbr %esc, escb(n, zr, zi, drift, out), step(n, zr, zi, cr, ci, mi, drift, out, %z2a, %z2b)
  step(n: i64, zr: f64, zi: f64, cr: f64, ci: f64, mi: i64, drift: f64, out: ptr, z2a: f64, z2b: f64):
    %done = icmp.sge i64 n, mi
    condbr %done, black(out), body(n, zr, zi, cr, ci, mi, drift, out, z2a, z2b)
  body(n: i64, zr: f64, zi: f64, cr: f64, ci: f64, mi: i64, drift: f64, out: ptr, z2a: f64, z2b: f64):
    %nzr = fsub f64 z2a, z2b
    %nzr2 = fadd f64 %nzr, cr
    %p = fmul f64 zr, zi
    %nzi = fadd f64 %p, %p
    %nzi2 = fadd f64 %nzi, ci
    %n2 = add i64 n, 1
    br iter(%n2, %nzr2, %nzi2, cr, ci, mi, drift, out)
  escb(n: i64, zr: f64, zi: f64, drift: f64, out: ptr):
    %a2a = fmul f64 zr, zr
    %a2b = fmul f64 zi, zi
    %a2 = fadd f64 %a2a, %a2b
    %az = call f64 ksqrt(%a2)
    %L = call f64 klog2(%az)
    %ll = call f64 klog2(%L)
    %nf = sitofp f64 n
    %nu0 = fadd f64 %nf, 1.0
    %nu = fsub f64 %nu0, %ll
    %ph0 = fma f64 1.35, %nu, drift
    %neg = fcmp.olt f64 %ph0, 0.0
    %ph0a = fadd f64 %ph0, 46.0
    %ph1 = select f64 %neg, %ph0a, %ph0
    %wd = fdiv f64 %ph1, 46.0
    %wi = fptosi i64 %wd
    %wf = sitofp f64 %wi
    %wm = fmul f64 %wf, 46.0
    %cyc = fsub f64 %ph1, %wm
    call void palette(%cyc, out)
    ret
}

; One frame: rotation and iteration limit from the frame index,
; half width carried in by the caller (it shrinks geometrically).
fn render_frame(ptr, ptr, i64, i64, f64) -> void {
  entry(buf: ptr, scratch: ptr, f: i64, F: i64, w: f64):
    %one = iconst i64 1
    %ff = sitofp f64 f
    %fF = sitofp f64 F
    %phi = fdiv f64 %ff, %fF
    %th = fmul f64 %phi, 6.283185307179586
    %over = fcmp.ogt f64 %th, 3.141592653589793
    %thw0 = fadd f64 %th, -6.283185307179586
    %thw = select f64 %over, %thw0, %th
    %st = call f64 ksin(%thw)
    %ca = fadd f64 %thw, 1.5707963267948966
    %cover = fcmp.ogt f64 %ca, 3.141592653589793
    %caw0 = fadd f64 %ca, -6.283185307179586
    %caw = select f64 %cover, %caw0, %ca
    %ct = call f64 ksin(%caw)
    %mi0 = mul i64 f, 2
    %mi = add i64 %mi0, 240
    %drift = fmul f64 %ff, 0.35
    br ploop(0, buf, scratch, w, %st, %ct, %mi, %drift)
  ploop(idx: i64, buf: ptr, scratch: ptr, w: f64, st: f64, ct: f64, mi: i64, drift: f64):
    %done = icmp.sge i64 idx, 921600
    condbr %done, pdone(), pbody(idx, buf, scratch, w, st, ct, mi, drift)
  pdone():
    ret
  pbody(idx: i64, buf: ptr, scratch: ptr, w: f64, st: f64, ct: f64, mi: i64, drift: f64):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %g2 = iconst i64 2
    %py = udiv i64 idx, 1280
    %rem = mul i64 %py, 1280
    %px = sub i64 idx, %rem
    %fx = sitofp f64 %px
    %fy = sitofp f64 %py
    %ux = fadd f64 %fx, -640.0
    %u = fmul f64 %ux, 0.002777777777777778
    %vy = fsub f64 360.0, %fy
    %v = fmul f64 %vy, 0.002777777777777778
    %x1 = fmul f64 %u, ct
    %x2 = fmul f64 %v, st
    %xr = fsub f64 %x1, %x2
    %y1 = fmul f64 %u, st
    %y2 = fmul f64 %v, ct
    %yr = fadd f64 %y1, %y2
    %cr = fma f64 %xr, w, -0.743643887030521
    %ci = fma f64 %yr, w, 0.131825904205330
    call void shade(%cr, %ci, mi, drift, scratch)
    %c0 = gep f64 scratch, 0
    %fr = load f64, %c0
    %c1 = gep f64 scratch, 1
    %fg = load f64, %c1
    %c2 = gep f64 scratch, 2
    %fb = load f64, %c2
    %wr = fmul f64 %fr, 255.0
    %rb = fptosi i32 %wr
    %wg = fmul f64 %fg, 255.0
    %gb = fptosi i32 %wg
    %wb = fmul f64 %fb, 255.0
    %bb = fptosi i32 %wb
    %sh1 = shl i32 255, 24
    %sh2 = shl i32 %bb, 16
    %sh3 = shl i32 %gb, 8
    %pk0 = or i32 %sh1, %sh2
    %pk1 = or i32 %pk0, %sh3
    %pack = or i32 %pk1, %rb
    %addr = gep i32 buf, idx
    store i32 %addr, %pack
    %idx2 = add i64 idx, 1
    br ploop(%idx2, buf, scratch, w, st, ct, mi, drift)
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %one = iconst i64 1
    %z32 = iconst i32 0
    %o32 = iconst i32 1
    %buf = call ptr malloc(3686400)
    %scratch = call ptr malloc(24)
    %pa = bitcast i64 %buf
    %ok = icmp.ne i64 %pa, 0
    condbr %ok, args(%buf, %scratch, argc, argv), fail()
  args(buf: ptr, scratch: ptr, argc: i32, argv: ptr):
    %has = icmp.sgt i32 argc, 1
    condbr %has, arg1(buf, scratch, argv), noarg(288, buf, scratch)
  arg1(buf: ptr, scratch: ptr, argv: ptr):
    %p = gep ptr argv, 1
    %s = load ptr, %p
    %fv = call i32 atoi(%s)
    br noarg(%fv, buf, scratch)
  noarg(frames: i32, buf: ptr, scratch: ptr):
    %lo = icmp.slt i32 frames, 1
    %f1 = select i32 %lo, 1, frames
    %hi = icmp.sgt i32 %f1, 600
    %f2 = select i32 %hi, 600, %f1
    %F = sext i64 %f2
    br floop(0, 1.6, buf, scratch, %F)
  floop(f: i64, w: f64, buf: ptr, scratch: ptr, F: i64):
    %done = icmp.sge i64 f, F
    condbr %done, finish(buf, scratch), fbody(f, w, buf, scratch, F)
  fbody(f: i64, w: f64, buf: ptr, scratch: ptr, F: i64):
    call void render_frame(buf, scratch, f, F, w)
    %wr = call i64 write(1, buf, 3686400)
    %w2 = fmul f64 w, 0.949158
    %f2 = add i64 f, 1
    br floop(%f2, %w2, buf, scratch, F)
  finish(buf: ptr, scratch: ptr):
    call void free(buf)
    call void free(scratch)
    ret 0
  fail():
    ret 1
}
