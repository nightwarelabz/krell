; ==============================================================================
; KRELL CORE: The Machine-Facing IR Dynamic Hologram Engine
; Pure Krell surface syntax. Zero external dependencies.
; Runs continuously until interrupted (Ctrl+C).
; Features:
;   - Fullscreen auto-adapting resolution via ioctl(TIOCGWINSZ)
;   - Double-buffered zero-flicker 24-bit truecolor ANSI output
;   - 3D Dual-Ring Quantum Gyroscope (intersecting tori with 3D z-buffering)
;   - Multi-wavelength organic flowing plasma background
;   - Specular luminance & cybernetic neon palette shading
;   - Dynamic demoscene HUD & telemetry readout
; ==============================================================================

extern write(i32, ptr, i64) -> i64
extern kc_winsize(i32, ptr) -> i32
extern usleep(i32) -> i32
extern malloc(i64) -> ptr
extern free(ptr) -> void
extern sin(f64) -> f64
extern cos(f64) -> f64
extern sqrt(f64) -> f64

data ramp : i8 = {
  32, 46, 44, 45, 126, 58, 59, 61, 33, 42, 35, 36, 64
}

data title_krell : i8 = {
  32, 91, 32, 75, 82, 69, 76, 76, 32, 67, 79, 82, 69, 32, 118, 49, 46, 48, 32, 93, 32
}

data title_engine : i8 = {
  32, 91, 32, 77, 65, 67, 72, 73, 78, 69, 32, 73, 82, 32, 69, 78, 71, 73, 78, 69, 32, 93, 32
}

data subtitle : i8 = {
  32, 32, 83, 83, 65, 32, 66, 76, 79, 67, 75, 45, 65, 82, 71, 32, 124, 32, 84, 79, 84, 65, 76, 32, 83, 69, 77, 65, 78, 84, 73, 67, 83, 32, 40, 78, 79, 32, 85, 66, 41, 32, 124, 32, 84, 65, 82, 71, 69, 84, 58, 32, 120, 56, 54, 95, 54, 52, 32, 78, 65, 84, 73, 86, 69
}

data footer_l : i8 = {
  32, 32, 70, 82, 65, 77, 69, 58, 32
}

data footer_r : i8 = {
  32, 124, 32, 67, 76, 73, 70, 70, 58, 32, 48, 32, 124, 32, 90, 69, 82, 79, 45, 76, 69, 65, 75, 32, 83, 83, 65, 32, 124, 32, 91, 67, 84, 82, 76, 43, 67, 32, 84, 79, 32, 69, 88, 73, 84, 93
}

data footer_bot : i8 = {
  32, 91, 32, 78, 73, 71, 72, 84, 87, 65, 82, 69, 32, 76, 65, 66, 90, 32, 58, 32, 80, 79, 82, 84, 65, 66, 76, 69, 32, 65, 83, 83, 69, 77, 66, 76, 89, 32, 93, 32
}

fn copy_bytes(ptr, ptr, i64) -> void {
  entry(dst: ptr, src: ptr, len: i64):
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    br loop(0, dst, src, len)
  loop(i: i64, dst: ptr, src: ptr, len: i64):
    %done = icmp.sge i64 i, len
    condbr %done, exit(), body(i, dst, src, len)
  body(i: i64, dst: ptr, src: ptr, len: i64):
    %sp = gep i8 src, i
    %b = load i8, %sp
    %dp = gep i8 dst, i
    store i8 %dp, %b
    %i2 = add i64 i, 1
    br loop(%i2, dst, src, len)
  exit():
    ret
}

fn put_u8(ptr, i64, i64) -> i64 {
  entry(buf: ptr, off: i64, val: i64):
    %c100 = iconst i64 100
    %c10 = iconst i64 10
    %c48 = iconst i64 48
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c3 = iconst i64 3
    %is_ge100 = icmp.sge i64 val, 100
    condbr %is_ge100, three(buf, off, val), check2(buf, off, val)
  three(buf: ptr, off: i64, val: i64):
    %d0 = sdiv i64 val, 100
    %m0 = srem i64 val, 100
    %d1 = sdiv i64 %m0, 10
    %d2 = srem i64 %m0, 10
    %ch0 = add i64 %d0, 48
    %ch1 = add i64 %d1, 48
    %ch2 = add i64 %d2, 48
    %b0 = trunc i8 %ch0
    %b1 = trunc i8 %ch1
    %b2 = trunc i8 %ch2
    %p0 = gep i8 buf, off
    store i8 %p0, %b0
    %o1 = add i64 off, 1
    %p1 = gep i8 buf, %o1
    store i8 %p1, %b1
    %o2 = add i64 off, 2
    %p2 = gep i8 buf, %o2
    store i8 %p2, %b2
    %o3 = add i64 off, 3
    ret %o3
  check2(buf: ptr, off: i64, val: i64):
    %is_ge10 = icmp.sge i64 val, 10
    condbr %is_ge10, two(buf, off, val), one(buf, off, val)
  two(buf: ptr, off: i64, val: i64):
    %d1_2 = sdiv i64 val, 10
    %d2_2 = srem i64 val, 10
    %ch1_2 = add i64 %d1_2, 48
    %ch2_2 = add i64 %d2_2, 48
    %b1_2 = trunc i8 %ch1_2
    %b2_2 = trunc i8 %ch2_2
    %p0_2 = gep i8 buf, off
    store i8 %p0_2, %b1_2
    %o1_2 = add i64 off, 1
    %p1_2 = gep i8 buf, %o1_2
    store i8 %p1_2, %b2_2
    %o2_2 = add i64 off, 2
    ret %o2_2
  one(buf: ptr, off: i64, val: i64):
    %ch2_1 = add i64 val, 48
    %b2_1 = trunc i8 %ch2_1
    %p0_1 = gep i8 buf, off
    store i8 %p0_1, %b2_1
    %o1_1 = add i64 off, 1
    ret %o1_1
}

fn put_digits6(ptr, i64, i64) -> i64 {
  entry(buf: ptr, off: i64, val: i64):
    %c1000000 = iconst i64 1000000
    %c100000 = iconst i64 100000
    %c10000 = iconst i64 10000
    %c1000 = iconst i64 1000
    %c100 = iconst i64 100
    %c10 = iconst i64 10
    %c48 = iconst i64 48
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c3 = iconst i64 3
    %c4 = iconst i64 4
    %c5 = iconst i64 5
    %c6 = iconst i64 6

    %v0 = srem i64 val, 1000000
    %d0 = sdiv i64 %v0, 100000
    %m0 = srem i64 %v0, 100000
    %d1 = sdiv i64 %m0, 10000
    %m1 = srem i64 %m0, 10000
    %d2 = sdiv i64 %m1, 1000
    %m2 = srem i64 %m1, 1000
    %d3 = sdiv i64 %m2, 100
    %m3 = srem i64 %m2, 100
    %d4 = sdiv i64 %m3, 10
    %d5 = srem i64 %m3, 10

    %ch0 = add i64 %d0, 48
    %ch1 = add i64 %d1, 48
    %ch2 = add i64 %d2, 48
    %ch3 = add i64 %d3, 48
    %ch4 = add i64 %d4, 48
    %ch5 = add i64 %d5, 48

    %b0 = trunc i8 %ch0
    %b1 = trunc i8 %ch1
    %b2 = trunc i8 %ch2
    %b3 = trunc i8 %ch3
    %b4 = trunc i8 %ch4
    %b5 = trunc i8 %ch5

    %p0 = gep i8 buf, off
    store i8 %p0, %b0
    %o1 = add i64 off, 1
    %p1 = gep i8 buf, %o1
    store i8 %p1, %b1
    %o2 = add i64 off, 2
    %p2 = gep i8 buf, %o2
    store i8 %p2, %b2
    %o3 = add i64 off, 3
    %p3 = gep i8 buf, %o3
    store i8 %p3, %b3
    %o4 = add i64 off, 4
    %p4 = gep i8 buf, %o4
    store i8 %p4, %b4
    %o5 = add i64 off, 5
    %p5 = gep i8 buf, %o5
    store i8 %p5, %b5
    %o6 = add i64 off, 6
    ret %o6
}

fn put_color(ptr, i64, i32, i32) -> i64 {
  entry(buf: ptr, off: i64, rgb: i32, is_bg: i32):
    %c27 = iconst i8 27
    %c91 = iconst i8 91
    %c51 = iconst i8 51
    %c52 = iconst i8 52
    %c56 = iconst i8 56
    %c59 = iconst i8 59
    %c50 = iconst i8 50
    %c109 = iconst i8 109
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c3 = iconst i64 3
    %c4 = iconst i64 4
    %c5 = iconst i64 5
    %c6 = iconst i64 6
    %c7 = iconst i64 7
    %c16 = iconst i32 16
    %c8 = iconst i32 8
    %c255 = iconst i32 255
    %c0_i32 = iconst i32 0

    %p0 = gep i8 buf, off
    store i8 %p0, 27
    %o1 = add i64 off, 1
    %p1 = gep i8 buf, %o1
    store i8 %p1, 91
    %o2 = add i64 off, 2
    %p2 = gep i8 buf, %o2
    %is_bg_b = icmp.ne i32 is_bg, 0
    %code = select i8 %is_bg_b, 52, 51
    store i8 %p2, %code
    %o3 = add i64 off, 3
    %p3 = gep i8 buf, %o3
    store i8 %p3, 56
    %o4 = add i64 off, 4
    %p4 = gep i8 buf, %o4
    store i8 %p4, 59
    %o5 = add i64 off, 5
    %p5 = gep i8 buf, %o5
    store i8 %p5, 50
    %o6 = add i64 off, 6
    %p6 = gep i8 buf, %o6
    store i8 %p6, 59
    %off_prefix = add i64 off, 7

    %r_sh = lshr i32 rgb, 16
    %r_b = and i32 %r_sh, 255
    %r64 = zext i64 %r_b
    %o_r = call i64 put_u8(buf, %off_prefix, %r64)
    %p_sc1 = gep i8 buf, %o_r
    store i8 %p_sc1, 59
    %off_g = add i64 %o_r, 1

    %g_sh = lshr i32 rgb, 8
    %g_b = and i32 %g_sh, 255
    %g64 = zext i64 %g_b
    %o_g = call i64 put_u8(buf, %off_g, %g64)
    %p_sc2 = gep i8 buf, %o_g
    store i8 %p_sc2, 59
    %off_b = add i64 %o_g, 1

    %b_b = and i32 rgb, 255
    %b64 = zext i64 %b_b
    %o_b = call i64 put_u8(buf, %off_b, %b64)
    %p_end = gep i8 buf, %o_b
    store i8 %p_end, 109
    %final_off = add i64 %o_b, 1
    ret %final_off
}

fn make_line(ptr, i64, i8, i8, i8, i64) -> i64 {
  entry(buf: ptr, off: i64, left_ch: i8, mid_ch: i8, right_ch: i8, width: i64):
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c10 = iconst i8 10
    %p0 = gep i8 buf, off
    store i8 %p0, left_ch
    %off1 = add i64 off, 1
    %w_mid = sub i64 width, 2
    br loop(0, buf, %off1, mid_ch, %w_mid, right_ch, off, width)
  loop(i: i64, buf: ptr, cur_p: i64, mid_ch: i8, count: i64, right_ch: i8, base_off: i64, width: i64):
    %done = icmp.sge i64 i, count
    condbr %done, finish(buf, cur_p, right_ch, base_off, width), body(i, buf, cur_p, mid_ch, count, right_ch, base_off, width)
  body(i: i64, buf: ptr, cur_p: i64, mid_ch: i8, count: i64, right_ch: i8, base_off: i64, width: i64):
    %p = gep i8 buf, cur_p
    store i8 %p, mid_ch
    %next_p = add i64 cur_p, 1
    %i2 = add i64 i, 1
    br loop(%i2, buf, %next_p, mid_ch, count, right_ch, base_off, width)
  finish(buf: ptr, cur_p: i64, right_ch: i8, base_off: i64, width: i64):
    %pend = gep i8 buf, cur_p
    store i8 %pend, right_ch
    %pnl = add i64 cur_p, 1
    %p_nl = gep i8 buf, %pnl
    store i8 %p_nl, 10
    %final_off = add i64 %pnl, 1
    ret %final_off
}

fn render_plasma(ptr, ptr, ptr, ptr, i64, i64, f64) -> void {
  entry(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64):
    ; Dominating constants
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    %c16 = iconst i32 16
    %c8 = iconst i32 8
    %c46 = iconst i8 46
    %c32 = iconst i8 32
    %c0_i32 = iconst i32 0
    %c80 = iconst i32 80
    %c110 = iconst i32 110
    %c160 = iconst i32 160
    %f0 = fconst f64 0.0
    %f05 = fconst f64 0.5
    %f26 = fconst f64 2.6
    %f32 = fconst f64 3.2
    %f09 = fconst f64 0.9
    %f18 = fconst f64 1.8
    %f07 = fconst f64 0.7
    %f40 = fconst f64 4.0
    %f14 = fconst f64 1.4
    %f025 = fconst f64 0.25
    %fpi = fconst f64 3.14159265
    %fpi05 = fconst f64 1.5707963
    %f16 = fconst f64 16.0
    %f20 = fconst f64 20.0
    %f12 = fconst f64 12.0
    %f30 = fconst f64 30.0
    %f42 = fconst f64 42.0
    %f042 = fconst f64 0.42
    %f08 = fconst f64 0.8

    %fc = sitofp f64 cols
    %fr = sitofp f64 rows
    %cx = fmul f64 %fc, 0.5
    %cy = fmul f64 %fr, 0.5
    br row_loop(0, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, %cx, %cy)
  row_loop(py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %done_y = icmp.sge i64 py, rows
    condbr %done_y, exit(), col_loop(0, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy)
  col_loop(px: i64, py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %done_x = icmp.sge i64 px, cols
    condbr %done_x, next_row(py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy), pix(px, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy)
  next_row(py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %py2 = add i64 py, 1
    br row_loop(%py2, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy)
  pix(px: i64, py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px

    %zp = gep f64 z_buf, %idx
    store f64 %zp, 0.0

    %fx = sitofp f64 px
    %fy = sitofp f64 py
    %dx = fsub f64 %fx, cx
    %dy = fsub f64 %fy, cy
    %u = fdiv f64 %dx, cx
    %v = fdiv f64 %dy, cy

    %u_sc = fmul f64 %u, 2.6
    %a1 = fadd f64 %u_sc, t
    %w1 = call f64 sin(%a1)

    %v_sc = fmul f64 %v, 3.2
    %t_09 = fmul f64 t, 0.9
    %a2 = fsub f64 %v_sc, %t_09
    %w2 = call f64 cos(%a2)

    %uv = fadd f64 %u, %v
    %uv_sc = fmul f64 %uv, 1.8
    %t_07 = fmul f64 t, 0.7
    %a3 = fadd f64 %uv_sc, %t_07
    %w3 = call f64 sin(%a3)

    %u2 = fmul f64 %u, %u
    %v2 = fmul f64 %v, %v
    %d2 = fadd f64 %u2, %v2
    %d = call f64 sqrt(%d2)
    %d_sc = fmul f64 %d, 4.0
    %t_14 = fmul f64 t, 1.4
    %a4 = fsub f64 %d_sc, %t_14
    %w4 = call f64 cos(%a4)

    %s12 = fadd f64 %w1, %w2
    %s34 = fadd f64 %w3, %w4
    %sall = fadd f64 %s12, %s34
    %pls = fmul f64 %sall, 0.25

    %p_pi = fmul f64 %pls, 3.14159265
    %arg_c1 = fadd f64 %p_pi, t
    %c1 = call f64 sin(%arg_c1)
    %r_term = fmul f64 %c1, 16.0
    %r_base = fadd f64 %r_term, 20.0
    %r_bg = fptosi i32 %r_base

    %t_08 = fmul f64 t, 0.8
    %arg_c2 = fsub f64 %p_pi, %t_08
    %c2 = call f64 cos(%arg_c2)
    %g_term = fmul f64 %c2, 12.0
    %g_base = fadd f64 %g_term, 16.0
    %g_bg = fptosi i32 %g_base

    %p_pi05 = fmul f64 %pls, 1.5707963
    %t_12 = fmul f64 t, 1.2
    %arg_c3 = fadd f64 %p_pi05, %t_12
    %c3 = call f64 sin(%arg_c3)
    %b_term = fmul f64 %c3, 30.0
    %b_base = fadd f64 %b_term, 42.0
    %b_bg = fptosi i32 %b_base

    %sh_r = shl i32 %r_bg, 16
    %sh_g = shl i32 %g_bg, 8
    %pk_bg0 = or i32 %sh_r, %sh_g
    %pk_bg = or i32 %pk_bg0, %b_bg

    %bg_p = gep i32 bg_buf, %idx
    store i32 %bg_p, %pk_bg

    %is_star = fcmp.ogt f64 %pls, 0.42
    condbr %is_star, star_cell(ch_buf, fg_buf, %idx, %r_bg, %g_bg, %b_bg, px, py, cols, rows, t, cx, cy), empty_cell(ch_buf, fg_buf, %idx, px, py, cols, rows, t, cx, cy)
  star_cell(ch_buf: ptr, fg_buf: ptr, idx: i64, r_bg: i32, g_bg: i32, b_bg: i32, px: i64, py: i64, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %ch_p = gep i8 ch_buf, idx
    store i8 %ch_p, 46
    %r_star = add i32 r_bg, 80
    %g_star = add i32 g_bg, 110
    %b_star = add i32 b_bg, 160
    %sh_rs = shl i32 %r_star, 16
    %sh_gs = shl i32 %g_star, 8
    %pk_f0 = or i32 %sh_rs, %sh_gs
    %pk_fg = or i32 %pk_f0, %b_star
    %fg_p = gep i32 fg_buf, idx
    store i32 %fg_p, %pk_fg
    %px2 = add i64 px, 1
    br col_loop(%px2, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy)
  empty_cell(ch_buf: ptr, fg_buf: ptr, idx: i64, px: i64, py: i64, cols: i64, rows: i64, t: f64, cx: f64, cy: f64):
    %ch_p2 = gep i8 ch_buf, idx
    store i8 %ch_p2, 32
    %fg_p2 = gep i32 fg_buf, idx
    store i32 %fg_p2, 0
    %px3 = add i64 px, 1
    br col_loop(%px3, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, cx, cy)
  exit():
    ret
}

fn render_ring(ptr, ptr, ptr, ptr, ptr, i64, i64, f64, f64, f64, f64, f64, i64, f64) -> void {
  entry(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, A: f64, B: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64):
    ; Dominating constants
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    %c8 = iconst i32 8
    %c16 = iconst i32 16
    %c12 = iconst i64 12
    %f0 = fconst f64 0.0
    %f1 = fconst f64 1.0
    %f05 = fconst f64 0.5
    %f125 = fconst f64 1.25
    %f205 = fconst f64 2.05
    %f2pi = fconst f64 6.2831853
    %f009 = fconst f64 0.09
    %f0035 = fconst f64 0.035
    %f12 = fconst f64 12.0
    %f075 = fconst f64 0.75
    %f025 = fconst f64 0.25
    %f255 = fconst f64 255.0
    %f13 = fconst f64 1.3
    %f07 = fconst f64 0.7
    %f20 = fconst f64 2.0
    %f15 = fconst f64 1.5
    %f045 = fconst f64 0.45
    %f055 = fconst f64 0.55
    %f08 = fconst f64 0.8
    %f02 = fconst f64 0.2

    %cA = call f64 cos(A)
    %sA = call f64 sin(A)
    %cB = call f64 cos(B)
    %sB = call f64 sin(B)

    %fc = sitofp f64 cols
    %fr = sitofp f64 rows
    %cx = fmul f64 %fc, 0.5
    %cy = fmul f64 %fr, 0.5
    %K1 = fmul f64 %fr, 1.25
    %aspect = fconst f64 2.05

    br theta_loop(0.0, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, %cA, %sA, %cB, %sB, R1, R2, K2, pal_mode, t, %cx, %cy, %K1, %aspect)
  theta_loop(th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64):
    %done_th = fcmp.ogt f64 th, 6.2831853
    condbr %done_th, exit(), phi_prep(th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect)
  phi_prep(th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64):
    %cth = call f64 cos(th)
    %sth = call f64 sin(th)
    %r2_cth = fmul f64 R2, %cth
    %h = fadd f64 R1, %r2_cth
    br phi_loop(0.0, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, %cth, %sth, %h)
  phi_loop(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64):
    %done_ph = fcmp.ogt f64 ph, 6.2831853
    condbr %done_ph, next_theta(th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect), calc_point(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  next_theta(th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64):
    %th2 = fadd f64 th, 0.09
    br theta_loop(%th2, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect)
  calc_point(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64):
    %cph = call f64 cos(ph)
    %sph = call f64 sin(ph)

    %m1 = fmul f64 cB, %cph
    %sA_sB = fmul f64 sA, sB
    %m2 = fmul f64 %sA_sB, %sph
    %t1 = fadd f64 %m1, %m2
    %X1 = fmul f64 h, %t1
    %cA_sB = fmul f64 cA, sB
    %R2_cA_sB = fmul f64 R2, %cA_sB
    %X2 = fmul f64 %R2_cA_sB, sth
    %X = fsub f64 %X1, %X2

    %m3 = fmul f64 sB, %cph
    %sA_cB = fmul f64 sA, cB
    %m4 = fmul f64 %sA_cB, %sph
    %t2 = fsub f64 %m3, %m4
    %Y1 = fmul f64 h, %t2
    %cA_cB = fmul f64 cA, cB
    %R2_cA_cB = fmul f64 R2, %cA_cB
    %Y2 = fmul f64 %R2_cA_cB, sth
    %Y = fadd f64 %Y1, %Y2

    %cA_h = fmul f64 cA, h
    %Z1 = fmul f64 %cA_h, %sph
    %R2_sA = fmul f64 R2, sA
    %Z2 = fmul f64 %R2_sA, sth
    %Z_sum = fadd f64 %Z1, %Z2
    %Z = fadd f64 K2, %Z_sum

    %ooz = fdiv f64 1.0, %Z

    %asp_K1 = fmul f64 aspect, K1
    %proj_x = fmul f64 %asp_K1, %X
    %off_x = fmul f64 %proj_x, %ooz
    %px_f = fadd f64 cx, %off_x
    %px = fptosi i64 %px_f

    %proj_y = fmul f64 K1, %Y
    %off_y = fmul f64 %proj_y, %ooz
    %py_f = fadd f64 cy, %off_y
    %py = fptosi i64 %py_f

    %c_x0 = icmp.sge i64 %px, 0
    %c_x1 = icmp.slt i64 %px, cols
    %ok_x = and i1 %c_x0, %c_x1
    %c_y0 = icmp.sge i64 %py, 0
    %c_y1 = icmp.slt i64 %py, rows
    %ok_y = and i1 %c_y0, %c_y1
    %inside = and i1 %ok_x, %ok_y
    condbr %inside, test_depth(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h, %cph, %sph, %ooz, %px, %py), next_phi(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  test_depth(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64, cph: f64, sph: f64, ooz: f64, px: i64, py: i64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px
    %zp = gep f64 z_buf, %idx
    %old_z = load f64, %zp
    %closer = fcmp.ogt f64 ooz, %old_z
    condbr %closer, write_pixel(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h, cph, sph, ooz, px, py, %zp, %idx), next_phi(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  write_pixel(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64, cph: f64, sph: f64, ooz: f64, px: i64, py: i64, zp: ptr, idx: i64):
    store f64 zp, ooz

    %cth_sB = fmul f64 cth, sB
    %term_L1 = fmul f64 cph, %cth_sB

    %cA_cth = fmul f64 cA, cth
    %term_L2 = fmul f64 %cA_cth, sph

    %term_L3 = fmul f64 sA, sth

    %cA_sth = fmul f64 cA, sth
    %cth_sA = fmul f64 cth, sA
    %cth_sA_sph = fmul f64 %cth_sA, sph
    %bracket = fsub f64 %cA_sth, %cth_sA_sph
    %term_L4 = fmul f64 cB, %bracket

    %L_a = fsub f64 %term_L1, %term_L2
    %L_b = fsub f64 %L_a, %term_L3
    %L_raw = fadd f64 %L_b, %term_L4

    %is_lit = fcmp.ogt f64 %L_raw, 0.0
    %L = select f64 %is_lit, %L_raw, 0.0

    %L_scale = fmul f64 %L, 12.0
    %L_idx_raw = fptosi i64 %L_scale
    %c_max = icmp.sgt i64 %L_idx_raw, 12
    %L_idx = select i64 %c_max, 12, %L_idx_raw

    %rp = gep i8 ramp, %L_idx
    %glyph = load i8, %rp
    %ch_p = gep i8 ch_buf, idx
    store i8 %ch_p, %glyph

    %is_pal0 = icmp.eq i64 pal_mode, 0
    condbr %is_pal0, pal0(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h, idx, %L), pal1(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h, idx, %L)
  pal0(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64, idx: i64, L: f64):
    %hue = fadd f64 ph, t
    %s_hue = call f64 sin(%hue)
    %r_unit = fmul f64 %s_hue, 0.5
    %r_u = fadd f64 %r_unit, 0.5

    %hue_13 = fmul f64 %hue, 1.3
    %c_hue = call f64 cos(%hue_13)
    %g_unit = fmul f64 %c_hue, 0.5
    %g_u = fadd f64 %g_unit, 0.5

    %hue_07 = fmul f64 %hue, 0.7
    %hue_07_2 = fadd f64 %hue_07, 2.0
    %b_hue = call f64 sin(%hue_07_2)
    %b_unit = fmul f64 %b_hue, 0.5
    %b_u = fadd f64 %b_unit, 0.5

    %L_lum = fmul f64 L, 0.75
    %lum = fadd f64 %L_lum, 0.25

    %rf = fmul f64 %r_u, %lum
    %rf255 = fmul f64 %rf, 255.0
    %r_int = fptosi i32 %rf255

    %gf = fmul f64 %g_u, %lum
    %gf255 = fmul f64 %gf, 255.0
    %g_int = fptosi i32 %gf255

    %bf = fmul f64 %b_u, %lum
    %bf255 = fmul f64 %bf, 255.0
    %b_int = fptosi i32 %bf255

    %sh_r = shl i32 %r_int, 16
    %sh_g = shl i32 %g_int, 8
    %pk0 = or i32 %sh_r, %sh_g
    %pk = or i32 %pk0, %b_int

    %fg_p = gep i32 fg_buf, idx
    store i32 %fg_p, %pk
    br next_phi(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  pal1(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64, idx: i64, L: f64):
    %t_15 = fmul f64 t, 1.5
    %hue1 = fsub f64 ph, %t_15

    %s_h1 = call f64 sin(%hue1)
    %s_h1_half = fmul f64 %s_h1, 0.45
    %g_u1 = fadd f64 %s_h1_half, 0.55

    %hue1_2 = fmul f64 %hue1, 2.0
    %c_h1 = call f64 cos(%hue1_2)
    %b_u1_half = fmul f64 %c_h1, 0.25
    %b_u1 = fadd f64 %b_u1_half, 0.25

    %L_lum1 = fmul f64 L, 0.8
    %lum1 = fadd f64 %L_lum1, 0.2

    %rf1_255 = fmul f64 %lum1, 255.0
    %r_int1 = fptosi i32 %rf1_255

    %gf1 = fmul f64 %g_u1, %lum1
    %gf1_255 = fmul f64 %gf1, 255.0
    %g_int1 = fptosi i32 %gf1_255

    %bf1 = fmul f64 %b_u1, %lum1
    %bf1_255 = fmul f64 %bf1, 255.0
    %b_int1 = fptosi i32 %bf1_255

    %sh_r1 = shl i32 %r_int1, 16
    %sh_g1 = shl i32 %g_int1, 8
    %pk0_1 = or i32 %sh_r1, %sh_g1
    %pk_1 = or i32 %pk0_1, %b_int1

    %fg_p1 = gep i32 fg_buf, idx
    store i32 %fg_p1, %pk_1
    br next_phi(ph, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  next_phi(ph: f64, th: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, cA: f64, sA: f64, cB: f64, sB: f64, R1: f64, R2: f64, K2: f64, pal_mode: i64, t: f64, cx: f64, cy: f64, K1: f64, aspect: f64, cth: f64, sth: f64, h: f64):
    %ph2 = fadd f64 ph, 0.035
    br phi_loop(%ph2, th, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, cA, sA, cB, sB, R1, R2, K2, pal_mode, t, cx, cy, K1, aspect, cth, sth, h)
  exit():
    ret
}

fn render_frame(ptr, ptr, ptr, ptr, i64, i64, i64, i64) -> i64 {
  entry(out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    ; Dominating constants
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c3 = iconst i64 3
    %c4 = iconst i64 4
    %c5 = iconst i64 5
    %c6 = iconst i64 6
    %c10 = iconst i8 10
    %c11 = iconst i64 11
    %c17 = iconst i64 17
    %c19 = iconst i64 19
    %c21 = iconst i64 21
    %c23 = iconst i64 23
    %c26 = iconst i64 26
    %c40 = iconst i64 40
    %c43 = iconst i8 43
    %c45 = iconst i8 45
    %c46 = iconst i64 46
    %c48 = iconst i8 48
    %c61 = iconst i8 61
    %c65 = iconst i64 65
    %c72 = iconst i8 72
    %c91 = iconst i8 91
    %c109 = iconst i8 109
    %c124 = iconst i8 124
    %c27 = iconst i8 27
    %c32 = iconst i8 32
    %m1 = iconst i32 -1
    %col_cyan = iconst i32 58879
    %col_void = iconst i32 329744
    %col_violet = iconst i32 12615935
    %col_gold = iconst i32 16756768

    %p0 = gep i8 out_buf, 0
    store i8 %p0, 27
    %p1 = gep i8 out_buf, 1
    store i8 %p1, 91
    %p2 = gep i8 out_buf, 2
    store i8 %p2, 72

    %o_col1 = call i64 put_color(out_buf, 3, 58879, 0)
    %o_col2 = call i64 put_color(out_buf, %o_col1, 329744, 1)
    %o_l1 = call i64 make_line(out_buf, %o_col2, 43, 61, 43, cols)
    %title_p = dataptr 1
    %dest_t = gep i8 out_buf, %o_col2
    %dest_t3 = gep i8 %dest_t, 3
    call void copy_bytes(%dest_t3, %title_p, 21)
    %has_w = icmp.sge i64 cols, 65
    condbr %has_w, ov_engine(out_buf, %o_col2, cols, %o_l1, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num), cont_l2(out_buf, %o_l1, cols, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num)
  ov_engine(out_buf: ptr, base_line1: i64, cols: i64, o_l1: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, rows: i64, gfx_rows: i64, frame_num: i64):
    %eng_p = dataptr 2
    %eng_col = sub i64 cols, 26
    %dest_e0 = gep i8 out_buf, base_line1
    %dest_e = gep i8 %dest_e0, %eng_col
    call void copy_bytes(%dest_e, %eng_p, 23)
    br cont_l2(out_buf, o_l1, cols, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num)
  cont_l2(out_buf: ptr, o_l1: i64, cols: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, rows: i64, gfx_rows: i64, frame_num: i64):
    %o_col3 = call i64 put_color(out_buf, o_l1, 12615935, 0)
    %o_l2 = call i64 make_line(out_buf, %o_col3, 124, 32, 124, cols)
    %sub_p = dataptr 3
    %dest_s0 = gep i8 out_buf, %o_col3
    %dest_s = gep i8 %dest_s0, 2
    %max_sub = sub i64 cols, 4
    %c_sub_fit = icmp.sgt i64 %max_sub, 65
    %sub_len = select i64 %c_sub_fit, 65, %max_sub
    %sub_pos = icmp.sgt i64 %sub_len, 0
    condbr %sub_pos, ov_sub(out_buf, %dest_s, %sub_p, %sub_len, %o_l2, cols, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num), cont_l3(out_buf, %o_l2, cols, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num)
  ov_sub(out_buf: ptr, dest_s: ptr, sub_p: ptr, sub_len: i64, o_l2: i64, cols: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, rows: i64, gfx_rows: i64, frame_num: i64):
    call void copy_bytes(dest_s, sub_p, sub_len)
    br cont_l3(out_buf, o_l2, cols, ch_buf, fg_buf, bg_buf, rows, gfx_rows, frame_num)
  cont_l3(out_buf: ptr, o_l2: i64, cols: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, rows: i64, gfx_rows: i64, frame_num: i64):
    %o_col4 = call i64 put_color(out_buf, o_l2, 58879, 0)
    %o_l3 = call i64 make_line(out_buf, %o_col4, 43, 45, 43, cols)
    br canvas_prep(out_buf, %o_l3, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  canvas_prep(out_buf: ptr, off: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    br canvas_row(0, off, -1, -1, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  canvas_row(py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %done_rows = icmp.sge i64 py, gfx_rows
    condbr %done_rows, canvas_done(off, out_buf, cols, rows, gfx_rows, frame_num), canvas_col(0, py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  canvas_col(px: i64, py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %done_cols = icmp.sge i64 px, cols
    condbr %done_cols, next_canvas_row(py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num), emit_cell(px, py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  next_canvas_row(py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %p_nl = gep i8 out_buf, off
    store i8 %p_nl, 10
    %off2 = add i64 off, 1
    %py2 = add i64 py, 1
    br canvas_row(%py2, %off2, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  emit_cell(px: i64, py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px
    %ch_p = gep i8 ch_buf, %idx
    %ch = load i8, %ch_p
    %fg_p = gep i32 fg_buf, %idx
    %fg = load i32, %fg_p
    %bg_p = gep i32 bg_buf, %idx
    %bg = load i32, %bg_p

    %diff_fg = icmp.ne i32 %fg, last_fg
    condbr %diff_fg, update_fg(px, py, off, %fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, %bg, %ch), check_bg(px, py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, %bg, %ch)
  update_fg(px: i64, py: i64, off: i64, new_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, cur_bg: i32, ch: i8):
    %o_fg = call i64 put_color(out_buf, off, new_fg, 0)
    br check_bg(px, py, %o_fg, new_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, cur_bg, ch)
  check_bg(px: i64, py: i64, off: i64, cur_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, cur_bg: i32, ch: i8):
    %diff_bg = icmp.ne i32 cur_bg, last_bg
    condbr %diff_bg, update_bg(px, py, off, cur_fg, cur_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, ch), put_char(px, py, off, cur_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, ch)
  update_bg(px: i64, py: i64, off: i64, cur_fg: i32, new_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, ch: i8):
    %o_bg = call i64 put_color(out_buf, off, new_bg, 1)
    br put_char(px, py, %o_bg, cur_fg, new_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, ch)
  put_char(px: i64, py: i64, off: i64, cur_fg: i32, cur_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, ch: i8):
    %cp = gep i8 out_buf, off
    store i8 %cp, ch
    %off_next = add i64 off, 1
    %px2 = add i64 px, 1
    br canvas_col(%px2, py, %off_next, cur_fg, cur_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  canvas_done(off: i64, out_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %o_bcol1 = call i64 put_color(out_buf, off, 58879, 0)
    %o_bcol2 = call i64 put_color(out_buf, %o_bcol1, 329744, 1)
    %o_b1 = call i64 make_line(out_buf, %o_bcol2, 43, 45, 43, cols)

    %o_bcol3 = call i64 put_color(out_buf, %o_b1, 16756768, 0)
    %o_b2 = call i64 make_line(out_buf, %o_bcol3, 124, 32, 124, cols)

    %fl_p = dataptr 4
    %dest_fl0 = gep i8 out_buf, %o_bcol3
    %dest_fl = gep i8 %dest_fl0, 2
    call void copy_bytes(%dest_fl, %fl_p, 9)

    %dest_num = gep i8 %dest_fl0, 11
    %o_num = call i64 put_digits6(%dest_fl0, 11, frame_num)

    %fr_p = dataptr 5
    %dest_fr = gep i8 %dest_fl0, 17
    %max_fr = sub i64 cols, 19
    %c_fr_fit = icmp.sgt i64 %max_fr, 46
    %fr_len = select i64 %c_fr_fit, 46, %max_fr
    %fr_pos = icmp.sgt i64 %fr_len, 0
    condbr %fr_pos, ov_fr(out_buf, %dest_fr, %fr_p, %fr_len, %o_b2, cols), cont_b3(out_buf, %o_b2, cols)
  ov_fr(out_buf: ptr, dest_fr: ptr, fr_p: ptr, fr_len: i64, o_b2: i64, cols: i64):
    call void copy_bytes(dest_fr, fr_p, fr_len)
    br cont_b3(out_buf, o_b2, cols)
  cont_b3(out_buf: ptr, o_b2: i64, cols: i64):
    %o_bcol4 = call i64 put_color(out_buf, o_b2, 58879, 0)
    %o_b3 = call i64 make_line(out_buf, %o_bcol4, 43, 61, 43, cols)
    %fbot_p = dataptr 6
    %dest_fb0 = gep i8 out_buf, %o_bcol4
    %dest_fb = gep i8 %dest_fb0, 3
    %max_fb = sub i64 cols, 5
    %c_fb_fit = icmp.sgt i64 %max_fb, 40
    %fb_len = select i64 %c_fb_fit, 40, %max_fb
    %fb_pos = icmp.sgt i64 %fb_len, 0
    condbr %fb_pos, ov_fbot(out_buf, %dest_fb, %fbot_p, %fb_len, %o_b3), cont_final(out_buf, %o_b3)
  ov_fbot(out_buf: ptr, dest_fb: ptr, fbot_p: ptr, fb_len: i64, o_b3: i64):
    call void copy_bytes(dest_fb, fbot_p, fb_len)
    br cont_final(out_buf, o_b3)
  cont_final(out_buf: ptr, o_b3: i64):
    %p_r0 = gep i8 out_buf, o_b3
    store i8 %p_r0, 27
    %o_r1 = add i64 o_b3, 1
    %p_r1b = gep i8 out_buf, %o_r1
    store i8 %p_r1b, 91
    %o_r2 = add i64 %o_r1, 1
    %p_r2b = gep i8 out_buf, %o_r2
    store i8 %p_r2b, 48
    %o_r3 = add i64 %o_r2, 1
    %p_r3b = gep i8 out_buf, %o_r3
    store i8 %p_r3b, 109
    %final_len = add i64 %o_r3, 1
    ret %final_len
}

fn main() -> i64 {
  entry():
    %c0 = iconst i64 0
    %c1 = iconst i64 1
    %c33000 = iconst i32 33000
    %ws = call ptr malloc(8)
    %rc = call i32 kc_winsize(1, %ws)
    %row_p = gep i16 %ws, 0
    %col_p = gep i16 %ws, 1
    %raw_rows = load i16, %row_p
    %raw_cols = load i16, %col_p
    call void free(%ws)

    %r64 = zext i64 %raw_rows
    %c64 = zext i64 %raw_cols

    %c_lo = icmp.slt i64 %c64, 40
    %cols_1 = select i64 %c_lo, 80, %c64
    %c_hi = icmp.sgt i64 %cols_1, 1000
    %cols = select i64 %c_hi, 1000, %cols_1

    %r_lo = icmp.slt i64 %r64, 20
    %rows_1 = select i64 %r_lo, 24, %r64
    %r_hi = icmp.sgt i64 %rows_1, 300
    %rows = select i64 %r_hi, 300, %rows_1

    %gfx_rows = sub i64 %rows, 6
    %gfx_cells = mul i64 %cols, %gfx_rows

    %out_buf = call ptr malloc(8388608)
    %ch_buf = call ptr malloc(%gfx_cells)
    %fg_bytes = mul i64 %gfx_cells, 4
    %fg_buf = call ptr malloc(%fg_bytes)
    %bg_buf = call ptr malloc(%fg_bytes)
    %z_bytes = mul i64 %gfx_cells, 8
    %z_buf = call ptr malloc(%z_bytes)

    ; Clear screen & hide cursor: [2J[?25l
    %init_buf = call ptr malloc(16)
    %p_i0 = gep i8 %init_buf, 0
    store i8 %p_i0, 27
    %p_i1 = gep i8 %init_buf, 1
    store i8 %p_i1, 91
    %p_i2 = gep i8 %init_buf, 2
    store i8 %p_i2, 50
    %p_i3 = gep i8 %init_buf, 3
    store i8 %p_i3, 74
    %p_i4 = gep i8 %init_buf, 4
    store i8 %p_i4, 27
    %p_i5 = gep i8 %init_buf, 5
    store i8 %p_i5, 91
    %p_i6 = gep i8 %init_buf, 6
    store i8 %p_i6, 63
    %p_i7 = gep i8 %init_buf, 7
    store i8 %p_i7, 50
    %p_i8 = gep i8 %init_buf, 8
    store i8 %p_i8, 53
    %p_i9 = gep i8 %init_buf, 9
    store i8 %p_i9, 108
    %wi = call i64 write(1, %init_buf, 10)
    call void free(%init_buf)

    %ramp = dataptr 0
    br anim_loop(0, %out_buf, %ch_buf, %fg_buf, %bg_buf, %z_buf, %ramp, %cols, %rows, %gfx_rows)
  anim_loop(frame: i64, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, ramp: ptr, cols: i64, rows: i64, gfx_rows: i64):
    %ff = sitofp f64 frame
    %t = fmul f64 %ff, 0.045

    call void render_plasma(ch_buf, fg_buf, bg_buf, z_buf, cols, gfx_rows, %t)

    %A1 = fmul f64 %t, 0.7
    %B1 = fmul f64 %t, 0.9
    call void render_ring(ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, gfx_rows, %A1, %B1, 1.95, 0.82, 5.2, 0, %t)

    %A2_neg = fmul f64 %t, -1.2
    %B2 = fmul f64 %t, 1.4
    call void render_ring(ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, gfx_rows, %A2_neg, %B2, 1.05, 0.42, 5.2, 1, %t)

    %frame_len = call i64 render_frame(out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame)
    %w = call i64 write(1, out_buf, %frame_len)

    %us = call i32 usleep(33000)
    %next_frame = add i64 frame, 1
    br anim_loop(%next_frame, out_buf, ch_buf, fg_buf, bg_buf, z_buf, ramp, cols, rows, gfx_rows)
}
