    %is_l1 = icmp.eq i64 layer, 1
    condbr %is_l1, write_l1(c, r, bits, layer, c_idx, w_idx, num_chars, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x, ch_p, fg_p, bg_p), write_l0(c, r, bits, layer, c_idx, w_idx, num_chars, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x, ch_p, fg_p, bg_p, px_f)
  write_l1(c: i64, r: i64, bits: i64, layer: i64, c_idx: i64, w_idx: i64, num_chars: i64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, char_base_x: f64, char_base_y: f64, wave_z: f64, lz: f64, off_x: f64, off_y: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64, ch_p: ptr, fg_p: ptr, bg_p: ptr):
    store i8 ch_p, 35 ; '#'
    store i32 fg_p, 5908640 ; (90, 40, 160) = 0x5A28A0
    store i32 bg_p, 1641010 ; (25, 10, 50) = 0x190A32
    br next_col(c, r, bits, layer, c_idx, w_idx, num_chars, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  write_l0(c: i64, r: i64, bits: i64, layer: i64, c_idx: i64, w_idx: i64, num_chars: i64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, char_base_x: f64, char_base_y: f64, wave_z: f64, lz: f64, off_x: f64, off_y: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64, ch_p: ptr, fg_p: ptr, bg_p: ptr, px_f: f64):
    %d_sw = fsub f64 px_f, sweep_x
    %d_abs = fabs f64 %d_sw
    %d_att = fmul f64 %d_abs, 0.18
    %sh_raw = fsub f64 1.0, %d_att
    %sh_neg = fcmp.olt f64 %sh_raw, 0.0
    %shine = select f64 %sh_neg, 0.0, %sh_raw
    %fr = sitofp f64 r
    %gt = fmul f64 %fr, 0.25
    %inv_gt = fsub f64 1.0, %gt
    %is_w0 = icmp.eq i64 w_idx, 0
    %cr_w0 = fmul f64 %gt, 255.0
    %cg_w0_a = fmul f64 %inv_gt, 240.0
    %cg_w0_b = fmul f64 %gt, 20.0
    %cg_w0 = fadd f64 %cg_w0_a, %cg_w0_b
    %cb_w0_a = fmul f64 %inv_gt, 255.0
    %cb_w0_b = fmul f64 %gt, 160.0
    %cb_w0 = fadd f64 %cb_w0_a, %cb_w0_b
    
    %cr_w1 = fconst f64 255.0
    %cg_w1 = fmul f64 %inv_gt, 210.0
    %cb_w1_a = fmul f64 %inv_gt, 40.0
    %cb_w1_b = fmul f64 %gt, 180.0
    %cb_w1 = fadd f64 %cb_w1_a, %cb_w1_b
    
    %cr_base = select f64 %is_w0, %cr_w0, %cr_w1
    %cg_base = select f64 %is_w0, %cg_w0, %cg_w1
    %cb_base = select f64 %is_w0, %cb_w0, %cb_w1
    %inv_sh = fsub f64 1.0, %shine
    %cr_sh0 = fmul f64 %cr_base, %inv_sh
    %sh_255 = fmul f64 %shine, 255.0
    %cr_final = fadd f64 %cr_sh0, %sh_255
    %cg_sh0 = fmul f64 %cg_base, %inv_sh
    %cg_final = fadd f64 %cg_sh0, %sh_255
    %cb_sh0 = fmul f64 %cb_base, %inv_sh
    %cb_final = fadd f64 %cb_sh0, %sh_255
    %ir = fptosi i32 %cr_final
    %ig = fptosi i32 %cg_final
    %ib = fptosi i32 %cb_final
    %sh_ir = shl i32 %ir, 16
    %sh_ig = shl i32 %ig, 8
    %pk_fg0 = or i32 %sh_ir, %sh_ig
    %pk_fg = or i32 %pk_fg0, %ib
    store i32 fg_p, %pk_fg
    %br_f = fmul f64 %cr_final, 0.25
    %bg_f = fmul f64 %cg_final, 0.25
    %bb_f = fmul f64 %cb_final, 0.25
    %ibr = fptosi i32 %br_f
    %ibg = fptosi i32 %bg_f
    %ibb = fptosi i32 %bb_f
    %sh_ibr = shl i32 %ibr, 16
    %sh_ibg = shl i32 %ibg, 8
    %pk_bg0 = or i32 %sh_ibr, %sh_ibg
    %pk_bg = or i32 %pk_bg0, %ibb
    store i32 bg_p, %pk_bg
    %is_hot = fcmp.ogt f64 %shine, 0.6
    %ch_f = select i8 %is_hot, 64, 35
    store i8 ch_p, %ch_f
    br next_col(c, r, bits, layer, c_idx, w_idx, num_chars, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  next_col(c: i64, r: i64, bits: i64, layer: i64, c_idx: i64, w_idx: i64, num_chars: i64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, char_base_x: f64, char_base_y: f64, wave_z: f64, lz: f64, off_x: f64, off_y: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    %c2 = add i64 c, 1
    br col_loop(%c2, r, bits, layer, c_idx, w_idx, num_chars, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  next_row(r: i64, layer: i64, c_idx: i64, w_idx: i64, num_chars: i64, char_w: f64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, char_base_x: f64, char_base_y: f64, wave_z: f64, lz: f64, off_x: f64, off_y: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    %r2 = add i64 r, 1
    br row_loop(%r2, layer, c_idx, w_idx, num_chars, char_w, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, lz, off_x, off_y, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  next_layer(layer: i64, c_idx: i64, w_idx: i64, num_chars: i64, char_w: f64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, char_base_x: f64, char_base_y: f64, wave_z: f64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    %l_prev = sub i64 layer, 1
    br layer_loop(%l_prev, c_idx, w_idx, num_chars, char_w, start_x, base_y_off, w_phase_off, glyphs, char_base_x, char_base_y, wave_z, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  next_char(c_idx: i64, w_idx: i64, num_chars: i64, char_w: f64, start_x: f64, base_y_off: f64, w_phase_off: f64, glyphs: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    %c_next = add i64 c_idx, 1
    br char_loop(%c_next, w_idx, num_chars, char_w, start_x, base_y_off, w_phase_off, glyphs, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  word_done(w_idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    %is_w0 = icmp.eq i64 w_idx, 0
    condbr %is_w0, start_word1(ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x), exit()
  start_word1(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, sweep_x: f64):
    br word_prep(1, ch_buf, fg_buf, bg_buf, z_buf, glyphs_nw, glyphs_lbz, cols, rows, t, cx, cy, sweep_x)
  exit():
    ret
}

fn render_equalizer(ptr, ptr, ptr, i64, i64, f64) -> void {
  entry(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, t: f64):
    ; Dominating constants auto-injected
    %_dom_f_0_25 = fconst f64 0.25
    %_dom_f_0_5 = fconst f64 0.5
    %_dom_f_2_8 = fconst f64 2.8
    %_dom_f_4_0 = fconst f64 4.0
    %_dom_i64_0 = iconst i64 0
    %_dom_i32_0 = iconst i32 0
    %_dom_i8_0 = iconst i8 0
    %_dom_i64_1 = iconst i64 1
    %_dom_i32_1 = iconst i32 1
    %_dom_i8_1 = iconst i8 1
    %_dom_i64_2 = iconst i64 2
    %_dom_i32_2 = iconst i32 2
    %_dom_i8_2 = iconst i8 2
    %_dom_i64_4 = iconst i64 4
    %_dom_i32_4 = iconst i32 4
    %_dom_i8_4 = iconst i8 4
    %_dom_i64_32 = iconst i64 32
    %_dom_i32_32 = iconst i32 32
    %_dom_i8_32 = iconst i8 32
    %_dom_i64_120 = iconst i64 120
    %_dom_i32_120 = iconst i32 120
    %_dom_i8_120 = iconst i8 120
    %_dom_i64_124 = iconst i64 124
    %_dom_i32_124 = iconst i32 124
    %_dom_i8_124 = iconst i8 124
    %_dom_i64_220 = iconst i64 220
    %_dom_i32_220 = iconst i32 220
    %_dom_i8_220 = iconst i8 220
    %_dom_i64_255 = iconst i64 255
    %_dom_i32_255 = iconst i32 255
    %_dom_i8_255 = iconst i8 255
    %_dom_i64_65400 = iconst i64 65400
    %_dom_i32_65400 = iconst i32 65400
    %_dom_i64_16770560 = iconst i64 16770560
    %_dom_i32_16770560 = iconst i32 16770560
    %eq_row = sub i64 rows, 2
    %c_lim = sub i64 cols, 4
    %is_wide = icmp.sgt i64 %c_lim, 32
    %n_bands = select i64 %is_wide, 32, %c_lim
    %tot_eq_w = mul i64 %n_bands, 2
    %rem_w = sub i64 cols, %tot_eq_w
    %start_eq_x = sdiv i64 %rem_w, 2
    br eq_loop(0, n_bands, start_eq_x, eq_row, ch_buf, fg_buf, cols, rows, t)
  eq_loop(b: i64, n_bands: i64, start_x: i64, eq_row: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %done = icmp.sge i64 b, n_bands
    condbr %done, exit(), eq_body(b, n_bands, start_x, eq_row, ch_buf, fg_buf, cols, rows, t)
  eq_body(b: i64, n_bands: i64, start_x: i64, eq_row: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %fb = sitofp f64 b
    %fb_sc = fmul f64 %fb, 0.25
    %t_4 = fmul f64 t, 4.0
    %arg = fadd f64 %t_4, %fb_sc
    %s_bt = call f64 sin(%arg)
    %s_half = fmul f64 %s_bt, 0.5
    %beat = fadd f64 %s_half, 0.5
    %h_f = fmul f64 %beat, 2.8
    %h = fptosi i64 %h_f
    %b2 = mul i64 b, 2
    %bx = add i64 start_x, %b2
    br h_loop(0, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  h_loop(eh: i64, h: i64, bx: i64, eq_row: i64, b: i64, n_bands: i64, start_x: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %done_h = icmp.sge i64 eh, 2
    condbr %done_h, next_b(b, n_bands, start_x, eq_row, ch_buf, fg_buf, cols, rows, t), h_check(eh, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  h_check(eh: i64, h: i64, bx: i64, eq_row: i64, b: i64, n_bands: i64, start_x: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %is_lit = icmp.sle i64 eh, h
    condbr %is_lit, h_plot(eh, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t), next_h(eh, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  h_plot(eh: i64, h: i64, bx: i64, eq_row: i64, b: i64, n_bands: i64, start_x: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %sub_eh = sub i64 1, eh
    %ey = add i64 eq_row, %sub_eh
    %c_x0 = icmp.sge i64 bx, 0
    %c_x1 = icmp.slt i64 bx, cols
    %ok_x = and i1 %c_x0, %c_x1
    %c_y0 = icmp.sge i64 %ey, 0
    %c_y1 = icmp.slt i64 %ey, rows
    %ok_y = and i1 %c_y0, %c_y1
    %inside = and i1 %ok_x, %ok_y
    condbr %inside, h_write(eh, h, bx, ey, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t), next_h(eh, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  h_write(eh: i64, h: i64, bx: i64, ey: i64, eq_row: i64, b: i64, n_bands: i64, start_x: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %row_off = mul i64 ey, cols
    %idx = add i64 %row_off, bx
    %is_h0 = icmp.eq i64 eh, 0
    %fg_col = select i32 %is_h0, 65400, 16770560 ; Green (0, 255, 120) = 65400 vs Gold/Yellow (255, 220, 0) = 16770560
    %fg_p = gep i32 fg_buf, idx
    store i32 %fg_p, %fg_col
    %ch_p = gep i8 ch_buf, idx
    store i8 %ch_p, 124 ; '|'
    br next_h(eh, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  next_h(eh: i64, h: i64, bx: i64, eq_row: i64, b: i64, n_bands: i64, start_x: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %eh2 = add i64 eh, 1
    br h_loop(%eh2, h, bx, eq_row, b, n_bands, start_x, ch_buf, fg_buf, cols, rows, t)
  next_b(b: i64, n_bands: i64, start_x: i64, eq_row: i64, ch_buf: ptr, fg_buf: ptr, cols: i64, rows: i64, t: f64):
    %b_next = add i64 b, 1
    br eq_loop(%b_next, n_bands, start_x, eq_row, ch_buf, fg_buf, cols, rows, t)
  exit():
    ret
}

fn render_frame(ptr, ptr, ptr, ptr, i64, i64, i64, i64, f64) -> i64 {
  entry(out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, t: f64):
