    %out_buf = call ptr malloc(8388608)
    %ch_buf = call ptr malloc(%gfx_cells)
    %fg_bytes = mul i64 %gfx_cells, 4
    %fg_buf = call ptr malloc(%fg_bytes)
    %bg_buf = call ptr malloc(%fg_bytes)
