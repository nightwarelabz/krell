    %dest_s0 = gep i8 out_buf, %o_col3
    %dest_s = gep i8 %dest_s0, 2
    %max_sub = sub i64 cols, 4
    %c_sub_fit = icmp.sgt i64 %max_sub, 69
    %sub_len = select i64 %c_sub_fit, 69, %max_sub
    %sub_pos = icmp.sgt i64 %sub_len, 0
