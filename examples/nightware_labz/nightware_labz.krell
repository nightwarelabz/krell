  emit_cell(px: i64, py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px
    %ch_p = gep i8 ch_buf, %idx
    %ch = load i8, %ch_p
    %fg_p = gep i32 fg_buf, %idx
    %fg = load i32, %fg_p
    %bg_p = gep i32 bg_buf, %idx
    %bg = load i32, %bg_p
    %diff_fg = icmp.ne i32 %fg, last_fg
    condbr %diff_fg, update_fg(px, py, off, %fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, %bg, %ch), check_bg(px, py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, %bg, %ch)
  update_fg(px: i64, py: i64, off: i64, new_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, cur_bg: i32, ch: i8):
    %o_fg = call i64 put_color(out_buf, off, new_fg, 0)
    br check_bg(px, py, %o_fg, new_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, cur_bg, ch)
  check_bg(px: i64, py: i64, off: i64, cur_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, cur_bg: i32, ch: i8):
    %diff_bg = icmp.ne i32 cur_bg, last_bg
    condbr %diff_bg, update_bg(px, py, off, cur_fg, cur_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, ch), put_char(px, py, off, cur_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num, ch)
  update_bg(px: i64, py: i64, off: i64, cur_fg: i32, new_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64, ch: i8):
    %o_bg = call i64 put_color(out_buf, off, new_bg, 1)
