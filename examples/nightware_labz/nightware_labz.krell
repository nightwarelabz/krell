  canvas_done(off: i64, out_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %o_bcol1 = call i64 put_color(out_buf, off, 61695, 0)
    %o_bcol2 = call i64 put_color(out_buf, %o_bcol1, 329748, 1)
