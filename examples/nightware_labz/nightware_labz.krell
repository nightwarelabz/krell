    %p3 = gep i8 buf, %o3
    store i8 %p3, 56
    %o4 = add i64 off, 4
    %p4 = gep i8 buf, %o4
    store i8 %p4, 59
    %o5 = add i64 off, 5
    %p5 = gep i8 buf, %o5
    store i8 %p5, 50
    %o6 = add i64 off, 6
    %p6 = gep i8 buf, %o6
    store i8 %p6, 59
    %off_prefix = add i64 off, 7
    %r_sh = lshr i32 rgb, 16
    %r_b = and i32 %r_sh, 255
    %r64 = zext i64 %r_b
    %o_r = call i64 put_u8(buf, %off_prefix, %r64)
    %p_sc1 = gep i8 buf, %o_r
    store i8 %p_sc1, 59
    %off_g = add i64 %o_r, 1
    %g_sh = lshr i32 rgb, 8
    %g_b = and i32 %g_sh, 255
    %g64 = zext i64 %g_b
    %o_g = call i64 put_u8(buf, %off_g, %g64)
    %p_sc2 = gep i8 buf, %o_g
    store i8 %p_sc2, 59
    %off_b = add i64 %o_g, 1
    %b_b = and i32 rgb, 255
    %b64 = zext i64 %b_b
    %o_b = call i64 put_u8(buf, %off_b, %b64)
    %p_end = gep i8 buf, %o_b
    store i8 %p_end, 109
    %final_off = add i64 %o_b, 1
    ret %final_off
}

fn make_line(ptr, i64, i8, i8, i8, i64) -> i64 {
  entry(buf: ptr, off: i64, left_ch: i8, mid_ch: i8, right_ch: i8, width: i64):
    ; Dominating constants auto-injected
    %_dom_i64_0 = iconst i64 0
    %_dom_i32_0 = iconst i32 0
    %_dom_i8_0 = iconst i8 0
    %_dom_i64_1 = iconst i64 1
    %_dom_i32_1 = iconst i32 1
    %_dom_i8_1 = iconst i8 1
    %_dom_i64_2 = iconst i64 2
    %_dom_i32_2 = iconst i32 2
    %_dom_i8_2 = iconst i8 2
    %_dom_i64_10 = iconst i64 10
    %_dom_i32_10 = iconst i32 10
    %_dom_i8_10 = iconst i8 10
    %p0 = gep i8 buf, off
    store i8 %p0, left_ch
    %off1 = add i64 off, 1
    %w_mid = sub i64 width, 2
    br loop(0, buf, %off1, mid_ch, %w_mid, right_ch, width)
  loop(i: i64, buf: ptr, cur_p: i64, mid_ch: i8, count: i64, right_ch: i8, width: i64):
    %done = icmp.sge i64 i, count
    condbr %done, finish(buf, cur_p, right_ch), body(i, buf, cur_p, mid_ch, count, right_ch, width)
  body(i: i64, buf: ptr, cur_p: i64, mid_ch: i8, count: i64, right_ch: i8, width: i64):
    %p = gep i8 buf, cur_p
    store i8 %p, mid_ch
    %next_p = add i64 cur_p, 1
    %i2 = add i64 i, 1
    br loop(%i2, buf, %next_p, mid_ch, count, right_ch, width)
  finish(buf: ptr, cur_p: i64, right_ch: i8):
    %pend = gep i8 buf, cur_p
    store i8 %pend, right_ch
    %pnl = add i64 cur_p, 1
    %p_nl = gep i8 buf, %pnl
    store i8 %p_nl, 10
    %final_off = add i64 %pnl, 1
    ret %final_off
}

