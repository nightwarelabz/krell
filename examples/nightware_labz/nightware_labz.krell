    br canvas_row(0, off, -1, -1, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  canvas_row(py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %done_rows = icmp.sge i64 py, gfx_rows
