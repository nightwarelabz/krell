    %_dom_i64_55 = iconst i64 55
    %_dom_i32_55 = iconst i32 55
    %_dom_i8_55 = iconst i8 55
    %_dom_i64_61 = iconst i64 61
    %_dom_i32_61 = iconst i32 61
    %_dom_i8_61 = iconst i8 61
    %_dom_i64_69 = iconst i64 69
    %_dom_i32_69 = iconst i32 69
    %_dom_i8_69 = iconst i8 69
    %_dom_i64_70 = iconst i64 70
    %_dom_i32_70 = iconst i32 70
    %_dom_i8_70 = iconst i8 70
    %_dom_i64_72 = iconst i64 72
    %_dom_i32_72 = iconst i32 72
    %_dom_i8_72 = iconst i8 72
    %_dom_i64_91 = iconst i64 91
    %_dom_i32_91 = iconst i32 91
    %_dom_i8_91 = iconst i8 91
    %_dom_i64_109 = iconst i64 109
    %_dom_i32_109 = iconst i32 109
    %_dom_i8_109 = iconst i8 109
    %_dom_i64_124 = iconst i64 124
    %_dom_i32_124 = iconst i32 124
    %_dom_i8_124 = iconst i8 124
    %_dom_i64_61695 = iconst i64 61695
    %_dom_i32_61695 = iconst i32 61695
    %_dom_i64_329748 = iconst i64 329748
    %_dom_i32_329748 = iconst i32 329748
    %_dom_i64_12548351 = iconst i64 12548351
    %_dom_i32_12548351 = iconst i32 12548351
    %_dom_i64_16765480 = iconst i64 16765480
    %_dom_i32_16765480 = iconst i32 16765480
    %p0 = gep i8 out_buf, 0
    store i8 %p0, 27
    %p1 = gep i8 out_buf, 1
    store i8 %p1, 91
    %p2 = gep i8 out_buf, 2
    store i8 %p2, 72
    %o_col1 = call i64 put_color(out_buf, 3, 61695, 0)
    %o_col2 = call i64 put_color(out_buf, %o_col1, 329748, 1)
    %o_l1 = call i64 make_line(out_buf, %o_col2, 43, 61, 43, cols)
    %title_p = dataptr 2 ; title_l
    %dest_t = gep i8 out_buf, %o_col2
    %dest_t3 = gep i8 %dest_t, 3
    call void copy_bytes(%dest_t3, %title_p, 25)
