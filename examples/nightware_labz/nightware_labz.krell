    %_dom_i8_31 = iconst i8 31
    %_dom_i64_32 = iconst i64 32
    %_dom_i32_32 = iconst i32 32
    %_dom_i8_32 = iconst i8 32
    %_dom_i64_43 = iconst i64 43
    %_dom_i32_43 = iconst i32 43
    %_dom_i8_43 = iconst i8 43
    %_dom_i64_45 = iconst i64 45
    %_dom_i32_45 = iconst i32 45
    %_dom_i8_45 = iconst i8 45
    %_dom_i64_48 = iconst i64 48
    %_dom_i32_48 = iconst i32 48
