    call void copy_bytes(dest_fb, fbot_p, fb_len)
    br cont_final(out_buf, o_b3)
  cont_final(out_buf: ptr, o_b3: i64):
    %p_r0 = gep i8 out_buf, o_b3
    store i8 %p_r0, 27
    %o_r1 = add i64 o_b3, 1
    %p_r1b = gep i8 out_buf, %o_r1
    store i8 %p_r1b, 91
    %o_r2 = add i64 %o_r1, 1
    %p_r2b = gep i8 out_buf, %o_r2
    store i8 %p_r2b, 48
    %o_r3 = add i64 %o_r2, 1
    %p_r3b = gep i8 out_buf, %o_r3
    store i8 %p_r3b, 109
    %final_len = add i64 %o_r3, 1
    ret %final_len
