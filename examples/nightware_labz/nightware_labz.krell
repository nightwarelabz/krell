  anim_loop(frame: i64, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, g_nw: ptr, g_lbz: ptr, cols: i64, rows: i64, gfx_rows: i64):
    %ff = sitofp f64 frame
    %t = fmul f64 %ff, 0.045
    call void render_background(ch_buf, fg_buf, bg_buf, z_buf, cols, gfx_rows, %t)
    call void render_rings(ch_buf, fg_buf, bg_buf, z_buf, cols, gfx_rows, %t)
    call void render_text(ch_buf, fg_buf, bg_buf, z_buf, g_nw, g_lbz, cols, gfx_rows, %t)
    call void render_equalizer(ch_buf, fg_buf, bg_buf, cols, gfx_rows, %t)
    %frame_len = call i64 render_frame(out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame, %t)
    %w = call i64 write(1, out_buf, %frame_len)
