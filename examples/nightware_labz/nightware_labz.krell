  canvas_col(px: i64, py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %done_cols = icmp.sge i64 px, cols
    condbr %done_cols, next_canvas_row(py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num), emit_cell(px, py, off, last_fg, last_bg, out_buf, ch_buf, fg_buf, bg_buf, cols, rows, gfx_rows, frame_num)
  next_canvas_row(py: i64, off: i64, last_fg: i32, last_bg: i32, out_buf: ptr, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, cols: i64, rows: i64, gfx_rows: i64, frame_num: i64):
    %p_nl = gep i8 out_buf, off
