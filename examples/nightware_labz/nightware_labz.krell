    %cx = fmul f64 %fc, 0.5
    %cy = fmul f64 %fr, 0.45
    %horizon = fmul f64 %fr, 0.70
    br row_loop(0, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, %fc, %fr, %cx, %cy, %horizon)
  row_loop(py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %done_y = icmp.sge i64 py, rows
    condbr %done_y, exit(), col_loop(0, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  col_loop(px: i64, py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %done_x = icmp.sge i64 px, cols
    condbr %done_x, next_row(py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon), pix(px, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  next_row(py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %py2 = add i64 py, 1
    br row_loop(%py2, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  pix(px: i64, py: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px
    %zp = gep f64 z_buf, %idx
    store f64 %zp, -1000000.0
    %fy = sitofp f64 py
    %fx = sitofp f64 px
    %is_ground = fcmp.oge f64 %fy, horizon
    condbr %is_ground, ground(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon, %fx, %fy), sky(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon, %fx, %fy)
  ground(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64, fx: f64, fy: f64):
    %num_dy = fsub f64 fy, horizon
    %num_dy2 = fadd f64 %num_dy, 0.5
    %den_dy = fsub f64 fr, horizon
    %den_dy2 = fadd f64 %den_dy, 0.5
    %dy = fdiv f64 %num_dy2, %den_dy2
    %z_den = fadd f64 %dy, 0.08
    %z_depth = fdiv f64 1.0, %z_den
    %dfx = fsub f64 fx, cx
    %gx_term = fmul f64 %dfx, %z_depth
    %gx = fmul f64 %gx_term, 0.075
    %gz_base = fmul f64 %z_depth, 0.70
    %t_spd = fmul f64 t, 3.5
    %gz = fadd f64 %gz_base, %t_spd
    %gx_pos = fadd f64 %gx, 10000.0
    %gx_i = fptosi i64 %gx_pos
    %gx_fl = sitofp f64 %gx_i
    %gx_fr = fsub f64 %gx_pos, %gx_fl
    %gx_hi = fcmp.ogt f64 %gx_fr, 0.5
    %gx_fr_sub = fsub f64 1.0, %gx_fr
    %gx_edge = select f64 %gx_hi, %gx_fr_sub, %gx_fr
    %is_grid_x = fcmp.olt f64 %gx_edge, 0.08
    %gz_pos = fadd f64 %gz, 10000.0
    %gz_i = fptosi i64 %gz_pos
    %gz_fl = sitofp f64 %gz_i
    %gz_fr = fsub f64 %gz_pos, %gz_fl
    %gz_hi = fcmp.ogt f64 %gz_fr, 0.5
    %gz_fr_sub = fsub f64 1.0, %gz_fr
    %gz_edge = select f64 %gz_hi, %gz_fr_sub, %gz_fr
    %is_grid_z = fcmp.olt f64 %gz_edge, 0.12
    %fog_raw = fmul f64 %dy, 1.4
    %fog_hi = fcmp.ogt f64 %fog_raw, 1.0
    %fog = select f64 %fog_hi, 1.0, %fog_raw
    %inv_fog = fsub f64 1.0, %fog
    %br_f = fmul f64 %inv_fog, 12.0
    %bg_f = fmul f64 %inv_fog, 6.0
    %bb_f = fmul f64 %inv_fog, 28.0
    %br = fptosi i32 %br_f
    %bg = fptosi i32 %bg_f
    %bb = fptosi i32 %bb_f
    %sh_r = shl i32 %br, 16
    %sh_g = shl i32 %bg, 8
    %bg_pk0 = or i32 %sh_r, %sh_g
    %bg_pk = or i32 %bg_pk0, %bb
    %bg_p = gep i32 bg_buf, idx
    store i32 %bg_p, %bg_pk
    %is_any_grid = or i1 %is_grid_x, %is_grid_z
    condbr %is_any_grid, grid_cell(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon, %fog, %is_grid_x, %is_grid_z), empty_ground(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  grid_cell(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64, fog: f64, is_x: i1, is_z: i1):
    %gr_f = fmul f64 fog, 255.0
    %gg_f = fmul f64 fog, 25.0
    %gb_f = fmul f64 fog, 190.0
    %gr = fptosi i32 %gr_f
    %gg = fptosi i32 %gg_f
    %gb = fptosi i32 %gb_f
    %sh_gr = shl i32 %gr, 16
    %sh_gg = shl i32 %gg, 8
    %fg_pk0 = or i32 %sh_gr, %sh_gg
    %fg_pk = or i32 %fg_pk0, %gb
    %fg_p = gep i32 fg_buf, idx
    store i32 %fg_p, %fg_pk
    %is_cross = and i1 is_x, is_z
    %ch_g1 = select i8 is_x, 124, 61
    %ch_grid = select i8 %is_cross, 43, %ch_g1
    %ch_p = gep i8 ch_buf, idx
    store i8 %ch_p, %ch_grid
    %px2 = add i64 px, 1
    br col_loop(%px2, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  empty_ground(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %ch_p0 = gep i8 ch_buf, idx
    store i8 %ch_p0, 32
    %fg_p0 = gep i32 fg_buf, idx
    store i32 %fg_p0, 0
    %px3 = add i64 px, 1
    br col_loop(%px3, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  sky(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64, fx: f64, fy: f64):
    %u_num = fsub f64 fx, cx
    %u = fdiv f64 %u_num, cx
    %v_num = fsub f64 fy, cy
    %v = fdiv f64 %v_num, cy
    %u_sc = fmul f64 %u, 2.2
    %a1 = fadd f64 %u_sc, t
    %w1 = call f64 sin(%a1)
    %v_sc = fmul f64 %v, 2.6
    %t_08 = fmul f64 t, 0.8
    %a2 = fsub f64 %v_sc, %t_08
    %w2 = call f64 cos(%a2)
    %uv = fadd f64 %u, %v
    %uv_sc = fmul f64 %uv, 1.6
    %t_06 = fmul f64 t, 0.6
    %a3 = fadd f64 %uv_sc, %t_06
    %w3 = call f64 sin(%a3)
    %s12 = fadd f64 %w1, %w2
    %s123 = fadd f64 %s12, %w3
    %pls = fmul f64 %s123, 0.333333
    %br_base = fmul f64 %pls, 14.0
    %br_f2 = fadd f64 %br_base, 12.0
    %br2 = fptosi i32 %br_f2
    %pls_pi = fmul f64 %pls, 3.14159265
    %t_08b = fmul f64 t, 0.8
    %bg_arg = fadd f64 %pls_pi, %t_08b
    %c_g = call f64 cos(%bg_arg)
    %bg_base = fmul f64 %c_g, 10.0
    %bg_f2 = fadd f64 %bg_base, 8.0
    %bg2 = fptosi i32 %bg_f2
    %pls_2 = fmul f64 %pls, 2.2
    %bb_arg = fsub f64 %pls_2, t
    %s_b = call f64 sin(%bb_arg)
    %bb_base = fmul f64 %s_b, 32.0
    %bb_f2 = fadd f64 %bb_base, 40.0
    %bb2 = fptosi i32 %bb_f2
    %sh_r2 = shl i32 %br2, 16
    %sh_g2 = shl i32 %bg2, 8
    %bg_pk0_2 = or i32 %sh_r2, %sh_g2
    %bg_pk2 = or i32 %bg_pk0_2, %bb2
    %bg_p2 = gep i32 bg_buf, idx
    store i32 %bg_p2, %bg_pk2
    %h1 = mul i64 px, 374761393
    %h2 = mul i64 py, 668265263
    %h_sum = add i64 %h1, %h2
    %h_pos = and i64 %h_sum, 2147483647
    %star_rem = srem i64 %h_pos, 43
    %is_star = icmp.eq i64 %star_rem, 0
    condbr %is_star, star_check(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon, %h_pos), empty_sky(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  star_check(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64, h_pos: i64):
    %rem100 = srem i64 h_pos, 100
    %f_rem = sitofp f64 %rem100
    %phase = fmul f64 %f_rem, 0.1
    %t_4 = fmul f64 t, 4.0
    %t_arg = fadd f64 %t_4, %phase
    %tw = call f64 sin(%t_arg)
    %is_tw = fcmp.ogt f64 %tw, 0.4
    condbr %is_tw, star_on(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon, %tw), empty_sky(px, py, idx, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  star_on(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64, tw: f64):
    %fg_p_star = gep i32 fg_buf, idx
    store i32 %fg_p_star, 11853311 ; (180, 220, 255)
    %is_big = fcmp.ogt f64 tw, 0.85
    %ch_star = select i8 %is_big, 42, 46 ; '*' or '.'
    %ch_p_star = gep i8 ch_buf, idx
    store i8 %ch_p_star, %ch_star
    %px4 = add i64 px, 1
    br col_loop(%px4, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  empty_sky(px: i64, py: i64, idx: i64, ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, fc: f64, fr: f64, cx: f64, cy: f64, horizon: f64):
    %ch_p_e = gep i8 ch_buf, idx
    store i8 %ch_p_e, 32
    %fg_p_e = gep i32 fg_buf, idx
    store i32 %fg_p_e, 0
    %px5 = add i64 px, 1
    br col_loop(%px5, py, ch_buf, fg_buf, bg_buf, z_buf, cols, rows, t, fc, fr, cx, cy, horizon)
  exit():
    ret
}

fn render_rings(ptr, ptr, ptr, ptr, i64, i64, f64) -> void {
  entry(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64):
    ; Dominating constants auto-injected
    %_dom_f_0_45 = fconst f64 0.45
    %_dom_f_0_48 = fconst f64 0.48
    %_dom_f_0_5 = fconst f64 0.5
    %_dom_f_0_8 = fconst f64 0.8
    %_dom_f_1_0 = fconst f64 1.0
    %_dom_f_1_1 = fconst f64 1.1
    %_dom_f_1_3 = fconst f64 1.3
    %_dom_f_1_5707963 = fconst f64 1.5707963
    %_dom_f_6_2831853 = fconst f64 6.2831853
    %_dom_f_22_0 = fconst f64 22.0
    %_dom_f_28_0 = fconst f64 28.0
    %_dom_f_55_0 = fconst f64 55.0
    %_dom_f_160_0 = fconst f64 160.0
    %_dom_i64_0 = iconst i64 0
    %_dom_i32_0 = iconst i32 0
    %_dom_i8_0 = iconst i8 0
    %_dom_i64_1 = iconst i64 1
    %_dom_i32_1 = iconst i32 1
    %_dom_i8_1 = iconst i8 1
    %_dom_i64_6 = iconst i64 6
    %_dom_i32_6 = iconst i32 6
    %_dom_i8_6 = iconst i8 6
    %_dom_i64_42 = iconst i64 42
    %_dom_i32_42 = iconst i32 42
    %_dom_i8_42 = iconst i8 42
    %_dom_i64_46 = iconst i64 46
    %_dom_i32_46 = iconst i32 46
    %_dom_i8_46 = iconst i8 46
    %_dom_i64_111 = iconst i64 111
    %_dom_i32_111 = iconst i32 111
    %_dom_i8_111 = iconst i8 111
    %_dom_i64_126 = iconst i64 126
    %_dom_i32_126 = iconst i32 126
    %_dom_i8_126 = iconst i8 126
    %_dom_i64_160 = iconst i64 160
    %_dom_i32_160 = iconst i32 160
    %_dom_i8_160 = iconst i8 160
    %_dom_i64_61695 = iconst i64 61695
    %_dom_i32_61695 = iconst i32 61695
    %_dom_i64_16727240 = iconst i64 16727240
    %_dom_i32_16727240 = iconst i32 16727240
    %fc = sitofp f64 cols
    %fr = sitofp f64 rows
    %cx = fmul f64 %fc, 0.5
    %cy = fmul f64 %fr, 0.45
    %r_maj = fmul f64 %fr, 0.48
    %A0 = fmul f64 t, 0.8
    %B0 = fmul f64 t, 1.1
    br ring_pts(0, 0, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, %r_maj, %A0, %B0)
  ring_pts(i: i64, ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64, A: f64, B: f64):
    %done = icmp.sge i64 i, 160
    condbr %done, ring_done(ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj), ring_body(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B)
  ring_body(i: i64, ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64, A: f64, B: f64):
    %fi = sitofp f64 i
    %th_step = fdiv f64 6.2831853, 160.0
    %th = fmul f64 %fi, %th_step
    %c_th = call f64 cos(%th)
    %s_th = call f64 sin(%th)
    %x0 = fmul f64 r_maj, %c_th
    %y0 = fmul f64 r_maj, %s_th
    %cA = call f64 cos(A)
    %sA = call f64 sin(A)
    %cB = call f64 cos(B)
    %sB = call f64 sin(B)
    %y1 = fmul f64 %y0, %cA
    %z1 = fmul f64 %y0, %sA
    %x2_a = fmul f64 %x0, %cB
    %x2_b = fmul f64 %z1, %sB
    %x2 = fadd f64 %x2_a, %x2_b
    %z2_a = fmul f64 %x0, %sB
    %z2_b = fmul f64 %z1, %cB
    %z2 = fsub f64 %z2_b, %z2_a
    %proj_z = fadd f64 %z2, 22.0
    %ooz = fdiv f64 1.0, %proj_z
    %x2_ooz = fmul f64 %x2, %ooz
    %x2_sc = fmul f64 %x2_ooz, 55.0
    %px_f = fadd f64 cx, %x2_sc
    %px = fptosi i64 %px_f
    %y1_ooz = fmul f64 %y1, %ooz
    %y1_sc = fmul f64 %y1_ooz, 28.0
    %py_f = fadd f64 cy, %y1_sc
    %py = fptosi i64 %py_f
    %c_x0 = icmp.sge i64 %px, 0
    %c_x1 = icmp.slt i64 %px, cols
    %ok_x = and i1 %c_x0, %c_x1
    %c_y0 = icmp.sge i64 %py, 0
    %c_y1 = icmp.slt i64 %py, rows
    %ok_y = and i1 %c_y0, %c_y1
    %inside = and i1 %ok_x, %ok_y
    condbr %inside, ring_plot(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B, %px, %py, %ooz), ring_next(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B)
  ring_plot(i: i64, ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64, A: f64, B: f64, px: i64, py: i64, ooz: f64):
    %row_off = mul i64 py, cols
    %idx = add i64 %row_off, px
    %zp = gep f64 z_buf, %idx
    %old_z = load f64, %zp
    %closer = fcmp.ogt f64 ooz, %old_z
    condbr %closer, ring_write(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B, %idx, %zp, ooz), ring_next(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B)
  ring_write(i: i64, ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64, A: f64, B: f64, idx: i64, zp: ptr, ooz: f64):
    store f64 zp, ooz
    %fg_p = gep i32 fg_buf, idx
    %ch_p = gep i8 ch_buf, idx
    %is_r0 = icmp.eq i64 ring_id, 0
    %fg_col = select i32 %is_r0, 61695, 16727240 ; Cyan 0x00F0FF (61695) vs Magenta 0xFF3CC8 (16727240)
    store i32 %fg_p, %fg_col
    %rem6 = srem i64 i, 6
    %is_nod = icmp.eq i64 %rem6, 0
    %ch_r0 = select i8 %is_nod, 111, 46 ; 'o' or '.'
    %ch_r1 = select i8 %is_nod, 42, 126 ; '*' or '~'
    %ch_val = select i8 %is_r0, %ch_r0, %ch_r1
    store i8 %ch_p, %ch_val
    br ring_next(i, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B)
  ring_next(i: i64, ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64, A: f64, B: f64):
    %i2 = add i64 i, 1
    br ring_pts(%i2, ring_id, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, A, B)
  ring_done(ring_id: i64, ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64):
    %is_r0 = icmp.eq i64 ring_id, 0
    condbr %is_r0, start_ring1(ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj), exit()
  start_ring1(ch_buf: ptr, fg_buf: ptr, z_buf: ptr, cols: i64, rows: i64, t: f64, cx: f64, cy: f64, r_maj: f64):
    %A1 = fmul f64 t, -1.1
    %B1_base = fmul f64 t, 1.3
    %B1 = fadd f64 %B1_base, 1.5707963
    br ring_pts(0, 1, ch_buf, fg_buf, z_buf, cols, rows, t, cx, cy, r_maj, %A1, %B1)
  exit():
    ret
}

fn render_text(ptr, ptr, ptr, ptr, ptr, ptr, i64, i64, f64) -> void {
  entry(ch_buf: ptr, fg_buf: ptr, bg_buf: ptr, z_buf: ptr, glyphs_nw: ptr, glyphs_lbz: ptr, cols: i64, rows: i64, t: f64):
    ; Dominating constants auto-injected
    %_dom_f_0_0 = fconst f64 0.0
    %_dom_f_0_08 = fconst f64 0.08
    %_dom_f_0_15 = fconst f64 0.15
    %_dom_f_0_18 = fconst f64 0.18
    %_dom_f_0_25 = fconst f64 0.25
    %_dom_f_0_45 = fconst f64 0.45
    %_dom_f_0_48 = fconst f64 0.48
    %_dom_f_0_5 = fconst f64 0.5
    %_dom_f_0_6 = fconst f64 0.6
    %_dom_f_0_7 = fconst f64 0.7
    %_dom_f_0_8 = fconst f64 0.8
    %_dom_f_1_0 = fconst f64 1.0
    %_dom_f_1_6 = fconst f64 1.6
    %_dom_f_1_8 = fconst f64 1.8
