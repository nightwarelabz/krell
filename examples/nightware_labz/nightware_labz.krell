fn copy_bytes(ptr, ptr, i64) -> void {
  entry(dst: ptr, src: ptr, len: i64):
    ; Dominating constants auto-injected
    %_dom_i64_0 = iconst i64 0
    %_dom_i32_0 = iconst i32 0
    %_dom_i8_0 = iconst i8 0
    %_dom_i64_1 = iconst i64 1
    %_dom_i32_1 = iconst i32 1
    %_dom_i8_1 = iconst i8 1
    br loop(0, dst, src, len)
  loop(i: i64, dst: ptr, src: ptr, len: i64):
    %done = icmp.sge i64 i, len
    condbr %done, exit(), body(i, dst, src, len)
  body(i: i64, dst: ptr, src: ptr, len: i64):
    %sp = gep i8 src, i
    %b = load i8, %sp
    %dp = gep i8 dst, i
    store i8 %dp, %b
    %i2 = add i64 i, 1
    br loop(%i2, dst, src, len)
  exit():
    ret
}

fn put_u8(ptr, i64, i64) -> i64 {
  entry(buf: ptr, off: i64, val: i64):
    ; Dominating constants auto-injected
    %_dom_i64_1 = iconst i64 1
    %_dom_i32_1 = iconst i32 1
    %_dom_i8_1 = iconst i8 1
    %_dom_i64_2 = iconst i64 2
    %_dom_i32_2 = iconst i32 2
    %_dom_i8_2 = iconst i8 2
    %_dom_i64_3 = iconst i64 3
    %_dom_i32_3 = iconst i32 3
    %_dom_i8_3 = iconst i8 3
    %_dom_i64_10 = iconst i64 10
    %_dom_i32_10 = iconst i32 10
    %_dom_i8_10 = iconst i8 10
    %_dom_i64_48 = iconst i64 48
    %_dom_i32_48 = iconst i32 48
    %_dom_i8_48 = iconst i8 48
    %_dom_i64_100 = iconst i64 100
    %_dom_i32_100 = iconst i32 100
    %_dom_i8_100 = iconst i8 100
    %c100 = iconst i64 100
    %c10 = iconst i64 10
    %c48 = iconst i64 48
    %c1 = iconst i64 1
    %c2 = iconst i64 2
    %c3 = iconst i64 3
    %is_ge100 = icmp.sge i64 val, 100
    condbr %is_ge100, three(buf, off, val), check2(buf, off, val)
  three(buf: ptr, off: i64, val: i64):
    %d0 = sdiv i64 val, 100
    %m0 = srem i64 val, 100
    %d1 = sdiv i64 %m0, 10
    %d2 = srem i64 %m0, 10
    %ch0 = add i64 %d0, 48
    %ch1 = add i64 %d1, 48
    %ch2 = add i64 %d2, 48
    %b0 = trunc i8 %ch0
    %b1 = trunc i8 %ch1
    %b2 = trunc i8 %ch2
    %p0 = gep i8 buf, off
    store i8 %p0, %b0
    %o1 = add i64 off, 1
    %p1 = gep i8 buf, %o1
    store i8 %p1, %b1
    %o2 = add i64 off, 2
    %p2 = gep i8 buf, %o2
    store i8 %p2, %b2
    %o3 = add i64 off, 3
    ret %o3
  check2(buf: ptr, off: i64, val: i64):
    %is_ge10 = icmp.sge i64 val, 10
    condbr %is_ge10, two(buf, off, val), one(buf, off, val)
  two(buf: ptr, off: i64, val: i64):
    %d1_2 = sdiv i64 val, 10
    %d2_2 = srem i64 val, 10
    %ch1_2 = add i64 %d1_2, 48
    %ch2_2 = add i64 %d2_2, 48
    %b1_2 = trunc i8 %ch1_2
    %b2_2 = trunc i8 %ch2_2
    %p0_2 = gep i8 buf, off
    store i8 %p0_2, %b1_2
    %o1_2 = add i64 off, 1
    %p1_2 = gep i8 buf, %o1_2
    store i8 %p1_2, %b2_2
    %o2_2 = add i64 off, 2
    ret %o2_2
  one(buf: ptr, off: i64, val: i64):
    %ch2_1 = add i64 val, 48
    %b2_1 = trunc i8 %ch2_1
    %p0_1 = gep i8 buf, off
    store i8 %p0_1, %b2_1
    %o1_1 = add i64 off, 1
    ret %o1_1
}

