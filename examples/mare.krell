; THE FRACTAL MARE
; The mare's head, built from Mandelbrot techniques, in Krell.
;
; The silhouette is a signed distance field: circles, capsules
; and tapered spikes, smooth-blended into skull, cheek, face,
; muzzle, jaw and neck, with a fanned mane of flame spikes and a
; carved chin. But the metal itself is fractal:
;
;   Every point inside the steel is also a point of the
;   Mandelbrot plane. One iteration per pixel serves two
;   readings: the smooth escape count etches contour bands into
;   the metal like an engraving, and an orbit trap (the closest
;   the orbit comes to the origin) raises bright filigree veins
;   where the steel would be polished. Inside the set the metal
;   goes dark. The window mapped onto the steel is the set's
;   upper filament sea, so spirals cross the skull and the
;   cardioid's coastline sweeps the neck.
;
;   The eye is a Julia set, iterated per pixel with c held near
;   (-0.8, 0.156), coloured as fire and set into a darkened
;   socket, with a red glow thrown onto the surrounding steel.
;
;   The mane spikes are steel too, but their edges catch an
;   ember light that strengthens with the same orbit trap, so
;   the flames flicker with fractal detail, not with a gradient.
;
; Lighting is a relief light from the upper left over normals
; taken from the distance field, so the fractal engraving still
; reads as carved metal.
;
; Host services: write, atoi, malloc, free. Nothing else computes.
; Output is one raw RGBA image on stdout.
;
; main: [mode] [size]   mode 0 = on black, 1 = transparent
;                        (default 0); size default 1600,
;                        clamped to 200..2400

extern write(i32, ptr, i64) -> i64
extern atoi(ptr) -> i32
extern malloc(i64) -> ptr
extern free(ptr) -> void

fn clamp01(f64) -> f64 {
  entry(v: f64):
    %lo = fcmp.olt f64 v, 0.0
    %a = select f64 %lo, 0.0, v
    %hi = fcmp.ogt f64 %a, 1.0
    %b = select f64 %hi, 1.0, %a
    ret %b
}

fn ksqrt(f64) -> f64 {
  entry(a: f64):
    %neg = fcmp.olt f64 a, 0.0
    %ac = select f64 %neg, 0.0, a
    %big = fcmp.ogt f64 %ac, 1.0
    %seed = select f64 %big, %ac, 1.0
    br it(6, %seed, %ac)
  it(n: i64, x: f64, a: f64):
    %q = fdiv f64 a, x
    %s = fadd f64 x, %q
    %x2 = fmul f64 %s, 0.5
    %n2 = sub i64 n, 1
    %more = icmp.sgt i64 %n2, 0
    condbr %more, it(%n2, %x2, a), done(%x2, a)
  done(x: f64, a: f64):
    %zero = fcmp.oeq f64 a, 0.0
    %r = select f64 %zero, 0.0, x
    ret %r
}

; log2(x) for x > 0: exponent from the float's bits, mantissa
; finished with the atanh series (as in gyre.krell).
fn klog2(f64) -> f64 {
  entry(x: f64):
    %bits = bitcast i64 x
    %eb = lshr i64 %bits, 52
    %ee = and i64 %eb, 2047
    %e = sub i64 %ee, 1023
    %ef = sitofp f64 %e
    %mb = and i64 %bits, 4503599627370495
    %m1b = or i64 %mb, 4607182418800017408
    %m = bitcast f64 %m1b
    %sn = fsub f64 %m, 1.0
    %sd = fadd f64 %m, 1.0
    %s = fdiv f64 %sn, %sd
    %s2 = fmul f64 %s, %s
    %h0 = fma f64 0.1111111111111111, %s2, 0.14285714285714285
    %h1 = fma f64 %h0, %s2, 0.2
    %h2 = fma f64 %h1, %s2, 0.3333333333333333
    %h3 = fma f64 %h2, %s2, 1.0
    %ln = fmul f64 %s, %h3
    %ln2 = fadd f64 %ln, %ln
    %frac = fmul f64 %ln2, 1.4426950408889634
    %r = fadd f64 %ef, %frac
    ret %r
}

fn mn2(f64, f64) -> f64 {
  entry(a: f64, b: f64):
    %c = fcmp.olt f64 a, b
    %r = select f64 %c, a, b
    ret %r
}

fn smin2(f64, f64, f64) -> f64 {
  entry(a: f64, b: f64, k: f64):
    %d = fsub f64 b, a
    %h0 = fdiv f64 %d, k
    %h1 = fma f64 0.5, %h0, 0.5
    %h = call f64 clamp01(%h1)
    %oh = fsub f64 1.0, %h
    %m0 = fmul f64 b, %oh
    %m1 = fma f64 a, %h, %m0
    %m2 = fmul f64 k, %h
    %m3 = fmul f64 %m2, %oh
    %r = fsub f64 %m1, %m3
    ret %r
}

fn smax2(f64, f64, f64) -> f64 {
  entry(a: f64, b: f64, k: f64):
    %na = fneg f64 a
    %nb = fneg f64 b
    %s = call f64 smin2(%na, %nb, k)
    %r = fneg f64 %s
    ret %r
}

fn sd_circle(f64, f64, f64, f64, f64) -> f64 {
  entry(px: f64, py: f64, cx: f64, cy: f64, r: f64):
    %dx = fsub f64 px, cx
    %dy = fsub f64 py, cy
    %a = fmul f64 %dx, %dx
    %b = fma f64 %dy, %dy, %a
    %d = call f64 ksqrt(%b)
    %res = fsub f64 %d, r
    ret %res
}

fn sd_capsule(f64, f64, f64, f64, f64, f64, f64) -> f64 {
  entry(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64, r: f64):
    %qx = fsub f64 px, ax
    %qy = fsub f64 py, ay
    %bax = fsub f64 bx, ax
    %bay = fsub f64 by, ay
    %d0 = fmul f64 %qx, %bax
    %d1 = fma f64 %qy, %bay, %d0
    %l0 = fmul f64 %bax, %bax
    %l1 = fma f64 %bay, %bay, %l0
    %h0 = fdiv f64 %d1, %l1
    %h = call f64 clamp01(%h0)
    %ex = fma f64 %bax, %h, 0.0
    %rx = fsub f64 %qx, %ex
    %ey = fmul f64 %bay, %h
    %ry = fsub f64 %qy, %ey
    %a = fmul f64 %rx, %rx
    %b = fma f64 %ry, %ry, %a
    %d = call f64 ksqrt(%b)
    %res = fsub f64 %d, r
    ret %res
}

; Tapered capsule: radius lerps from r0 at a to 0.004 at b.
fn sd_spike(f64, f64, f64, f64, f64, f64, f64) -> f64 {
  entry(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64, r0: f64):
    %qx = fsub f64 px, ax
    %qy = fsub f64 py, ay
    %bax = fsub f64 bx, ax
    %bay = fsub f64 by, ay
    %d0 = fmul f64 %qx, %bax
    %d1 = fma f64 %qy, %bay, %d0
    %l0 = fmul f64 %bax, %bax
    %l1 = fma f64 %bay, %bay, %l0
    %h0 = fdiv f64 %d1, %l1
    %h = call f64 clamp01(%h0)
    %ex = fmul f64 %bax, %h
    %rx = fsub f64 %qx, %ex
    %ey = fmul f64 %bay, %h
    %ry = fsub f64 %qy, %ey
    %a = fmul f64 %rx, %rx
    %b = fma f64 %ry, %ry, %a
    %d = call f64 ksqrt(%b)
    %om = fsub f64 1.0, %h
    %r = fma f64 r0, %om, 0.0
    %r2 = fma f64 0.004, %h, %r
    %res = fsub f64 %d, %r2
    ret %res
}

; The mare's distance field. Writes body distance to scratch[0]
; and mane distance to scratch[1]; returns the blended field.
fn field(f64, f64, ptr) -> f64 {
  entry(px: f64, py: f64, scratch: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %b0 = call f64 sd_circle(px, py, 0.605, 0.42, 0.13)
    %t1 = call f64 sd_circle(px, py, 0.615, 0.545, 0.10)
    %b1 = call f64 smin2(%b0, %t1, 0.045)
    %t2 = call f64 sd_capsule(px, py, 0.675, 0.395, 0.805, 0.55, 0.060)
    %b2 = call f64 smin2(%b1, %t2, 0.045)
    %t3 = call f64 sd_circle(px, py, 0.812, 0.583, 0.047)
    %b3 = call f64 smin2(%b2, %t3, 0.035)
    %cv = call f64 sd_circle(px, py, 0.748, 0.662, 0.048)
    %ncv = fneg f64 %cv
    %b4 = call f64 smax2(%b3, %ncv, 0.02)
    %t5 = call f64 sd_capsule(px, py, 0.60, 0.60, 0.555, 0.72, 0.07)
    %b5 = call f64 smin2(%b4, %t5, 0.045)
    %t6 = call f64 sd_capsule(px, py, 0.54, 0.58, 0.485, 0.995, 0.15)
    %b6 = call f64 smin2(%b5, %t6, 0.05)
    %t7 = call f64 sd_capsule(px, py, 0.455, 0.52, 0.375, 0.99, 0.135)
    %b7 = call f64 smin2(%b6, %t7, 0.05)
    %t8 = call f64 sd_capsule(px, py, 0.43, 0.70, 0.40, 0.90, 0.13)
    %b8 = call f64 smin2(%b7, %t8, 0.05)
    %t9 = call f64 sd_capsule(px, py, 0.68, 0.335, 0.79, 0.315, 0.045)
    %b9 = call f64 smin2(%b8, %t9, 0.03)
    %t10 = call f64 sd_spike(px, py, 0.775, 0.325, 0.845, 0.222, 0.028)
    %b10 = call f64 smin2(%b9, %t10, 0.015)
    %t11 = call f64 sd_spike(px, py, 0.75, 0.318, 0.798, 0.242, 0.020)
    %body = call f64 smin2(%b10, %t11, 0.015)
    %m0 = call f64 sd_spike(px, py, 0.615, 0.295, 0.475, 0.035, 0.052)
    %s1 = call f64 sd_spike(px, py, 0.555, 0.295, 0.335, 0.045, 0.054)
    %m1 = call f64 mn2(%m0, %s1)
    %s2 = call f64 sd_spike(px, py, 0.495, 0.315, 0.205, 0.105, 0.056)
    %m2 = call f64 mn2(%m1, %s2)
    %s3 = call f64 sd_spike(px, py, 0.445, 0.355, 0.075, 0.225, 0.056)
    %m3 = call f64 mn2(%m2, %s3)
    %s4 = call f64 sd_spike(px, py, 0.415, 0.415, 0.03, 0.385, 0.054)
    %m4 = call f64 mn2(%m3, %s4)
    %s5 = call f64 sd_spike(px, py, 0.405, 0.475, 0.065, 0.55, 0.050)
    %m5 = call f64 mn2(%m4, %s5)
    %s6 = call f64 sd_spike(px, py, 0.475, 0.275, 0.415, 0.095, 0.042)
    %m6 = call f64 mn2(%m5, %s6)
    %s7 = call f64 sd_spike(px, py, 0.65, 0.285, 0.615, 0.165, 0.036)
    %m7 = call f64 mn2(%m6, %s7)
    %s8 = call f64 sd_spike(px, py, 0.52, 0.33, 0.30, 0.17, 0.040)
    %m8 = call f64 mn2(%m7, %s8)
    %s9 = call f64 sd_spike(px, py, 0.45, 0.44, 0.16, 0.40, 0.042)
    %m9 = call f64 mn2(%m8, %s9)
    %u1 = call f64 sd_spike(px, py, 0.50, 0.31, 0.27, 0.185, 0.070)
    %m10 = call f64 mn2(%m9, %u1)
    %u2 = call f64 sd_spike(px, py, 0.435, 0.40, 0.13, 0.315, 0.075)
    %m11 = call f64 mn2(%m10, %u2)
    %u3 = call f64 sd_spike(px, py, 0.42, 0.475, 0.125, 0.49, 0.068)
    %mane = call f64 mn2(%m11, %u3)
    %a0 = gep f64 scratch, 0
    store f64 %a0, %body
    %a1 = gep f64 scratch, 1
    store f64 %a1, %mane
    %d = call f64 smin2(%body, %mane, 0.018)
    ret %d
}

; One Mandelbrot iteration per steel point, read two ways.
; Writes scratch[2] = smooth escape count (or -1 inside the set),
; scratch[3] = orbit trap value, scratch[4] = depth fraction
; (iterations used / limit, 1 when escaped).
fn orbit(f64, f64, ptr) -> void {
  entry(cr: f64, ci: f64, scratch: ptr):
    %g2 = iconst i64 2
    %g3 = iconst i64 3
    %g4 = iconst i64 4
    %one = fmul f64 1.0, 1.0
    br it(0, 0.0, 0.0, 10.0, cr, ci, scratch)
  it(n: i64, zr: f64, zi: f64, trap: f64, cr: f64, ci: f64, scratch: ptr):
    %z2a = fmul f64 zr, zr
    %z2b = fmul f64 zi, zi
    %m2 = fadd f64 %z2a, %z2b
    %esc = fcmp.ogt f64 %m2, 4.0
    condbr %esc, escb(n, zr, zi, trap, scratch), step(n, zr, zi, trap, cr, ci, scratch, %z2a, %z2b)
  step(n: i64, zr: f64, zi: f64, trap: f64, cr: f64, ci: f64, scratch: ptr, z2a: f64, z2b: f64):
    %done = icmp.sge i64 n, 240
    condbr %done, inb(trap, scratch), body(n, zr, zi, trap, cr, ci, scratch, z2a, z2b)
  body(n: i64, zr: f64, zi: f64, trap: f64, cr: f64, ci: f64, scratch: ptr, z2a: f64, z2b: f64):
    %nzr = fsub f64 z2a, z2b
    %nzr2 = fadd f64 %nzr, cr
    %p = fmul f64 zr, zi
    %nzi = fadd f64 %p, %p
    %nzi2 = fadd f64 %nzi, ci
    %nm0 = fmul f64 %nzr2, %nzr2
    %nm = fma f64 %nzi2, %nzi2, %nm0
    %trap2 = call f64 mn2(trap, %nm)
    %n2 = add i64 n, 1
    br it(%n2, %nzr2, %nzi2, %trap2, cr, ci, scratch)
  escb(n: i64, zr: f64, zi: f64, trap: f64, scratch: ptr):
    %a2a = fmul f64 zr, zr
    %a2b = fmul f64 zi, zi
    %a2 = fadd f64 %a2a, %a2b
    %az = call f64 ksqrt(%a2)
    %L = call f64 klog2(%az)
    %ll = call f64 klog2(%L)
    %nf = sitofp f64 n
    %nu0 = fadd f64 %nf, 1.0
    %nu = fsub f64 %nu0, %ll
    %a2 = gep f64 scratch, 2
    store f64 %a2, %nu
    %a3 = gep f64 scratch, 3
    store f64 %a3, trap
    %dep = fdiv f64 %nf, 240.0
    %a4 = gep f64 scratch, 4
    store f64 %a4, %dep
    ret
  inb(trap: f64, scratch: ptr):
    %a2 = gep f64 scratch, 2
    store f64 %a2, -1.0
    %a3 = gep f64 scratch, 3
    store f64 %a3, trap
    %a4 = gep f64 scratch, 4
    store f64 %a4, 1.0
    ret
}

; The eye: a Julia set with c = (-0.8, 0.156), coloured as fire.
; Writes r, g, b to scratch[6..8]; an interior point is the
; white-hot core.
fn julia(f64, f64, ptr) -> void {
  entry(px: f64, py: f64, scratch: ptr):
    %g6 = iconst i64 6
    %g7 = iconst i64 7
    %g8 = iconst i64 8
    %dx = fsub f64 px, 0.712
    %dy = fsub f64 py, 0.502
    %dxr = fma f64 %dx, 0.9397, 0.0
    %dxr2 = fma f64 %dy, 0.3420, %dxr
    %dyr = fma f64 %dy, 0.9397, 0.0
    %dyr2 = fma f64 %dx, -0.3420, %dyr
    %z0r = fmul f64 %dxr2, 30.0
    %z0i = fmul f64 %dyr2, 30.0
    %mz = fmul f64 %z0r, 0.0
    %mo = fadd f64 %mz, 1.0
    br it(0, %z0r, %z0i, scratch)
  it(n: i64, zr: f64, zi: f64, scratch: ptr):
    %z2a = fmul f64 zr, zr
    %z2b = fmul f64 zi, zi
    %m2 = fadd f64 %z2a, %z2b
    %esc = fcmp.ogt f64 %m2, 4.0
    condbr %esc, escb(n, zr, zi, scratch), step(n, zr, zi, scratch, %z2a, %z2b)
  step(n: i64, zr: f64, zi: f64, scratch: ptr, z2a: f64, z2b: f64):
    %done = icmp.sge i64 n, 60
    condbr %done, core(scratch), body(n, zr, zi, scratch, z2a, z2b)
  body(n: i64, zr: f64, zi: f64, scratch: ptr, z2a: f64, z2b: f64):
    %nzr = fsub f64 z2a, z2b
    %nzr2 = fadd f64 %nzr, -0.8
    %p = fmul f64 zr, zi
    %nzi = fadd f64 %p, %p
    %nzi2 = fadd f64 %nzi, 0.156
    %n2 = add i64 n, 1
    br it(%n2, %nzr2, %nzi2, scratch)
  escb(n: i64, zr: f64, zi: f64, scratch: ptr):
    %a2a = fmul f64 zr, zr
    %a2b = fmul f64 zi, zi
    %a2 = fadd f64 %a2a, %a2b
    %az = call f64 ksqrt(%a2)
    %L = call f64 klog2(%az)
    %ll = call f64 klog2(%L)
    %nf = sitofp f64 n
    %nu0 = fadd f64 %nf, 1.0
    %nu = fsub f64 %nu0, %ll
    br fire(%nu, scratch)
  core(scratch: ptr):
    br fire(60.0, scratch)
  fire(nu: f64, scratch: ptr):
    %t0 = fmul f64 nu, 0.016666666666666666
    %t = call f64 clamp01(%t0)
    %s1 = fmul f64 %t, 2.857142857142857
    %f1 = call f64 clamp01(%s1)
    %s2a = fsub f64 %t, 0.35
    %s2 = fmul f64 %s2a, 3.3333333333333335
    %f2 = call f64 clamp01(%s2)
    %s3a = fsub f64 %t, 0.65
    %s3 = fmul f64 %s3a, 4.166666666666667
    %f3 = call f64 clamp01(%s3)
    %s4a = fsub f64 %t, 0.89
    %s4 = fmul f64 %s4a, 9.090909090909092
    %f4 = call f64 clamp01(%s4)
    %r0 = fma f64 0.55, %f1, 0.0
    %g0v = fma f64 0.02, %f1, 0.0
    %b0 = fma f64 0.0, %f1, 0.0
    %r1d = fsub f64 1.0, %r0
    %r1 = fma f64 %r1d, %f2, %r0
    %g1d = fsub f64 0.22, %g0v
    %g1 = fma f64 %g1d, %f2, %g0v
    %b1d = fsub f64 0.02, %b0
    %b1 = fma f64 %b1d, %f2, %b0
    %r2d = fsub f64 1.0, %r1
    %r2 = fma f64 %r2d, %f3, %r1
    %g2d = fsub f64 0.8, %g1
    %g2 = fma f64 %g2d, %f3, %g1
    %b2d = fsub f64 0.35, %b1
    %b2 = fma f64 %b2d, %f3, %b1
    %r3d = fsub f64 1.0, %r2
    %r3 = fma f64 %r3d, %f4, %r2
    %g3d = fsub f64 1.0, %g2
    %g3 = fma f64 %g3d, %f4, %g2
    %b3d = fsub f64 1.0, %b2
    %b3 = fma f64 %b3d, %f4, %b2
    %a6 = gep f64 scratch, 6
    store f64 %a6, %r3
    %a7 = gep f64 scratch, 7
    store f64 %a7, %g3
    %a8 = gep f64 scratch, 8
    store f64 %a8, %b3
    ret
}

; One pixel. Writes r, g, b, a (each 0..1) to out[0..3].
fn pixel(f64, f64, f64, i64, ptr, ptr) -> void {
  entry(px: f64, py: f64, fsize: f64, mode: i64, scratch: ptr, out: ptr):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %g2 = iconst i64 2
    %g3 = iconst i64 3
    %g6 = iconst i64 6
    %g7 = iconst i64 7
    %g8 = iconst i64 8
    %d0 = call f64 field(px, py, scratch)
    %mz = fmul f64 %d0, 0.0
    %mo = fadd f64 %mz, 1.0
    %a0s = gep f64 scratch, 0
    %bodyD = load f64, %a0s
    %a1s = gep f64 scratch, 1
    %maneD = load f64, %a1s
    %cov0 = fmul f64 %d0, fsize
    %cov1 = fsub f64 0.5, %cov0
    %cov = call f64 clamp01(%cov1)
    %far = fcmp.ogt f64 %d0, 0.01
    condbr %far, bg(%cov, mode, out), near(px, py, fsize, mode, scratch, out, %d0, %bodyD, %maneD, %cov)
  bg(cov: f64, mode: i64, out: ptr):
    %isT = icmp.eq i64 mode, 1
    %ba = select f64 %isT, 0.0, 1.0
    %a0 = gep f64 out, 0
    store f64 %a0, 0.0
    %a1 = gep f64 out, 1
    store f64 %a1, 0.0
    %a2 = gep f64 out, 2
    store f64 %a2, 0.0
    %a3 = gep f64 out, 3
    store f64 %a3, %ba
    ret
  near(px: f64, py: f64, fsize: f64, mode: i64, scratch: ptr, out: ptr, d0: f64, bodyD: f64, maneD: f64, cov: f64):
    %e = fdiv f64 0.75, fsize
    %pxr = fadd f64 px, %e
    %dR = call f64 field(%pxr, py, scratch)
    %pxl = fsub f64 px, %e
    %dL = call f64 field(%pxl, py, scratch)
    %pyd = fadd f64 py, %e
    %dD = call f64 field(px, %pyd, scratch)
    %pyu = fsub f64 py, %e
    %dU = call f64 field(px, %pyu, scratch)
    %gx = fsub f64 %dR, %dL
    %gy = fsub f64 %dD, %dU
    %nx = fmul f64 %gx, -2.2
    %ny = fmul f64 %gy, 2.2
    %nl0 = fmul f64 %nx, %nx
    %nl1 = fma f64 %ny, %ny, %nl0
    %nl2 = fadd f64 %nl1, 1.0
    %nl = call f64 ksqrt(%nl2)
    %nxu = fdiv f64 %nx, %nl
    %nyu = fdiv f64 %ny, %nl
    %nzu = fdiv f64 1.0, %nl
    %diff0 = fmul f64 %nxu, -0.2789
    %diff1 = fma f64 %nyu, -0.3612, %diff0
    %diff2 = fma f64 %nzu, 0.8973, %diff1
    %diff = call f64 clamp01(%diff2)
    %ndh0 = fmul f64 %nxu, -0.14292
    %ndh1 = fma f64 %nyu, -0.18509, %ndh0
    %ndh = fma f64 %nzu, 0.97238, %ndh1
    %ndhc = call f64 clamp01(%ndh)
    %sp0 = fmul f64 %ndhc, %ndhc
    %sp1 = fmul f64 %sp0, %sp0
    %sp2 = fmul f64 %sp1, %sp1
    %sp3 = fmul f64 %sp2, %sp2
    %sp4 = fmul f64 %sp3, %sp3
    %sp5 = fmul f64 %sp4, %sp4
    %spec = fmul f64 %sp5, %sp0
    %cr = fma f64 px, 1.1, -1.1
    %ciy = fsub f64 1.0, py
    %ci = fma f64 %ciy, 1.1, 0.07
    call void orbit(%cr, %ci, scratch)
    %s2p = gep f64 scratch, 2
    %nuA = load f64, %s2p
    %s3p = gep f64 scratch, 3
    %trap = load f64, %s3p
    %s4p = gep f64 scratch, 4
    %dep = load f64, %s4p
    %inset = fcmp.olt f64 %nuA, 0.0
    %band0 = fmul f64 %nuA, 1.2
    %bi = fptosi i64 %band0
    %bf = sitofp f64 %bi
    %bfr = fsub f64 %band0, %bf
    %btri0 = fmul f64 %bfr, 2.0
    %btri1 = fsub f64 %btri0, 1.0
    %btri = fabs f64 %btri1
    %stripe = fma f64 0.65, %btri, 0.35
    %tdist = call f64 ksqrt(%trap)
    %fil0 = fmul f64 %tdist, 9.0
    %fil1 = fsub f64 1.0, %fil0
    %filr = call f64 clamp01(%fil1)
    %fil = fmul f64 %filr, %filr
    %insh0 = fma f64 -0.55, %tdist, 0.46
    %inshade = call f64 clamp01(%insh0)
    %ashade = select f64 %inset, %inshade, %stripe
    %fade0 = fmul f64 %nuA, 0.010
    %fade1 = fsub f64 1.05, %fade0
    %fade = call f64 clamp01(%fade1)
    %ashf = fmul f64 %ashade, %fade
    %ashadeF = select f64 %inset, %ashade, %ashf
    %base0 = fma f64 0.22, %diff, 0.07
    %base1 = fmul f64 %base0, %ashadeF
    %filw = fma f64 0.70, %diff, 0.30
    %filc = fmul f64 %fil, %filw
    %filg = select f64 %inset, 0.22, 1.0
    %filc1 = fmul f64 %filc, %filg
    %filc2 = fmul f64 %filc1, 0.5
    %grey0 = fadd f64 %base1, %filc2
    %specw = fmul f64 %spec, 0.5
    %grey1 = fadd f64 %grey0, %specw
    %grey = call f64 clamp01(%grey1)
    %md = fsub f64 bodyD, maneD
    %mm0 = fmul f64 %md, 40.0
    %mm1 = fadd f64 %mm0, 0.5
    %maneM = call f64 clamp01(%mm1)
    %inner = fneg f64 d0
    %edge0 = fdiv f64 %inner, 0.022
    %edge1 = fsub f64 1.0, %edge0
    %edge = call f64 clamp01(%edge1)
    %tip0 = fadd f64 0.52, 0.0
    %tip1 = fsub f64 %tip0, px
    %tip2 = fmul f64 py, 0.30
    %tip3 = fsub f64 %tip1, %tip2
    %tip4 = fmul f64 %tip3, 3.2
    %tip = call f64 clamp01(%tip4)
    %emb0 = fmul f64 %maneM, %edge
    %emb1 = fmul f64 %emb0, %tip
    %embE = fmul f64 %emb1, %edge
    %emb2 = fma f64 0.75, %fil, 0.25
    %embS = fmul f64 %embE, %emb2
    %emb = fmul f64 %embS, 0.8
    %dxe = fsub f64 px, 0.712
    %dye = fsub f64 py, 0.502
    %dxr = fma f64 %dxe, 0.9397, 0.0
    %dxr2 = fma f64 %dye, 0.3420, %dxr
    %dyr = fma f64 %dye, 0.9397, 0.0
    %dyr2 = fma f64 %dxe, -0.3420, %dyr
    %ex = fdiv f64 %dxr2, 0.0125
    %ey = fdiv f64 %dyr2, 0.028
    %ee0 = fmul f64 %ex, %ex
    %ee = fma f64 %ey, %ey, %ee0
    %sock0 = fdiv f64 %ee, 2.6
    %sock1 = fsub f64 1.0, %sock0
    %sock = call f64 clamp01(%sock1)
    %sockw = fma f64 -0.45, %sock, 1.0
    %r = fmul f64 %grey, 0.92
    %g = fmul f64 %grey, 0.97
    %b = fmul f64 %grey, 1.06
    %r1 = fmul f64 %r, %sockw
    %g1v = fmul f64 %g, %sockw
    %b1 = fmul f64 %b, %sockw
    %er = fmul f64 %emb, 1.0
    %eg = fmul f64 %emb, 0.30
    %eb = fmul f64 %emb, 0.04
    %r2 = fadd f64 %r1, %er
    %g2 = fadd f64 %g1v, %eg
    %b2 = fadd f64 %b1, %eb
    %gl0 = call f64 ksqrt(%ee)
    %gl1 = fmul f64 %gl0, 0.55
    %gl2 = fsub f64 1.0, %gl1
    %gl3 = call f64 clamp01(%gl2)
    %glow = fmul f64 %gl3, %gl3
    %glow2 = fmul f64 %glow, 0.5
    %r3 = fma f64 1.0, %glow2, %r2
    %g3 = fma f64 0.1, %glow2, %g2
    %b3 = fma f64 0.02, %glow2, %b2
    %ineye = fcmp.olt f64 %ee, 1.0
    condbr %ineye, eyepx(px, py, scratch, out, cov), shadeout(%r3, %g3, %b3, mode, out, cov)
  eyepx(px: f64, py: f64, scratch: ptr, out: ptr, cov: f64):
    call void julia(px, py, scratch)
    %s6p = gep f64 scratch, 6
    %fr = load f64, %s6p
    %s7p = gep f64 scratch, 7
    %fg = load f64, %s7p
    %s8p = gep f64 scratch, 8
    %fb = load f64, %s8p
    br shadeout(%fr, %fg, %fb, 0, out, cov)
  shadeout(r: f64, g: f64, b: f64, mode: i64, out: ptr, cov: f64):
    %rc = call f64 clamp01(r)
    %gc = call f64 clamp01(g)
    %bc = call f64 clamp01(b)
    %isT = icmp.eq i64 mode, 1
    %oa = select f64 %isT, cov, 1.0
    %a0 = gep f64 out, 0
    store f64 %a0, %rc
    %a1 = gep f64 out, 1
    store f64 %a1, %gc
    %a2 = gep f64 out, 2
    store f64 %a2, %bc
    %a3 = gep f64 out, 3
    store f64 %a3, %oa
    ret
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, argv: ptr):
    %one = iconst i64 1
    %z32 = iconst i32 0
    %o32 = iconst i32 1
    %scratch = call ptr malloc(128)
    %out = call ptr malloc(32)
    %ps = bitcast i64 %scratch
    %ok = icmp.ne i64 %ps, 0
    condbr %ok, args(%scratch, %out, argc, argv), fail()
  args(scratch: ptr, out: ptr, argc: i32, argv: ptr):
    %has = icmp.sgt i32 argc, 1
    condbr %has, arg1(scratch, out, argv, argc), noarg(0, 1600, scratch, out)
  arg1(scratch: ptr, out: ptr, argv: ptr, argc: i32):
    %p = gep ptr argv, 1
    %s = load ptr, %p
    %mv = call i32 atoi(%s)
    %has2 = icmp.sgt i32 argc, 2
    condbr %has2, arg2(%mv, scratch, out, argv), noarg(%mv, 1600, scratch, out)
  arg2(mv: i32, scratch: ptr, out: ptr, argv: ptr):
    %p = gep ptr argv, 2
    %s = load ptr, %p
    %sv = call i32 atoi(%s)
    br noarg(%mv, %sv, scratch, out)
  noarg(mv: i32, sv: i32, scratch: ptr, out: ptr):
    %mlo = icmp.slt i32 mv, 0
    %m1 = select i32 %mlo, 0, mv
    %mhi = icmp.sgt i32 %m1, 1
    %mode = select i32 %mhi, 1, %m1
    %slo = icmp.slt i32 sv, 200
    %s1 = select i32 %slo, 200, sv
    %shi = icmp.sgt i32 %s1, 2400
    %sv2 = select i32 %shi, 2400, %s1
    %S = sext i64 %sv2
    %mode64 = sext i64 %mode
    %np = mul i64 %S, %S
    %bsz = mul i64 %np, 4
    %buf = call ptr malloc(%bsz)
    %pb = bitcast i64 %buf
    %okb = icmp.ne i64 %pb, 0
    condbr %okb, ploop(0, %buf, scratch, out, %mode64, %S, %np), fail()
  ploop(idx: i64, buf: ptr, scratch: ptr, out: ptr, mode: i64, S: i64, np: i64):
    %done = icmp.sge i64 idx, np
    condbr %done, finish(buf, scratch, out, np), pbody(idx, buf, scratch, out, mode, S, np)
  pbody(idx: i64, buf: ptr, scratch: ptr, out: ptr, mode: i64, S: i64, np: i64):
    %g0 = iconst i64 0
    %g1 = iconst i64 1
    %g2 = iconst i64 2
    %g3 = iconst i64 3
    %pyi = udiv i64 idx, S
    %rem = mul i64 %pyi, S
    %pxi = sub i64 idx, %rem
    %fx = sitofp f64 %pxi
    %fy = sitofp f64 %pyi
    %fs = sitofp f64 S
    %cx = fadd f64 %fx, 0.5
    %px = fdiv f64 %cx, %fs
    %cy = fadd f64 %fy, 0.5
    %py = fdiv f64 %cy, %fs
    call void pixel(%px, %py, %fs, mode, scratch, out)
    %c0 = gep f64 out, 0
    %fr = load f64, %c0
    %c1 = gep f64 out, 1
    %fg = load f64, %c1
    %ob = bitcast i64 out
    %ob2 = add i64 %ob, 16
    %c2 = bitcast ptr %ob2
    %fb = load f64, %c2
    %c3 = gep f64 out, 3
    %fa = load f64, %c3
    %wr = fmul f64 %fr, 255.0
    %rb = fptosi i32 %wr
    %wg = fmul f64 %fg, 255.0
    %gb = fptosi i32 %wg
    %wb = fmul f64 %fb, 255.0
    %bb = fptosi i32 %wb
    %wa = fmul f64 %fa, 255.0
    %ab = fptosi i32 %wa
    %sh1 = shl i32 %ab, 24
    %sh2 = shl i32 %bb, 16
    %sh3 = shl i32 %gb, 8
    %pk0 = or i32 %sh1, %sh2
    %pk1 = or i32 %pk0, %sh3
    %pack = or i32 %pk1, %rb
    %addr = gep i32 buf, idx
    store i32 %addr, %pack
    %idx2 = add i64 idx, 1
    br ploop(%idx2, buf, scratch, out, mode, S, np)
  finish(buf: ptr, scratch: ptr, out: ptr, np: i64):
    %bsz = mul i64 np, 4
    %wr = call i64 write(1, buf, %bsz)
    call void free(buf)
    call void free(scratch)
    call void free(out)
    ret 0
  fail():
    ret 1
}
