# RUNG cost oracle — riscv64 (RVA23 profile: Zbb present, no vector unit
# assumed by the v1 backend — vector ops are scalarized there, hence the
# high latencies; vudiv/vfdiv are cliffs).
# lat = latency cycles (representative), thr = reciprocal throughput.
vl 4
op add.i lat 1 thr 1
op sub.i lat 1 thr 1
op mul.i lat 3 thr 1
op udiv.i lat 20 thr 12
op sdiv.i lat 20 thr 12
op urem.i lat 20 thr 12
op srem.i lat 20 thr 12
op neg.i lat 1 thr 1
op and.i lat 1 thr 1
op or.i lat 1 thr 1
op xor.i lat 1 thr 1
op not.i lat 1 thr 1
op shl.i lat 1 thr 1
op lshr.i lat 1 thr 1
op fshl.i lat 5 thr 3
op fshr.i lat 5 thr 3
op ashr.i lat 1 thr 1
op icmp.i lat 2 thr 1
op popcount.i lat 2 thr 1
op clz.i lat 2 thr 1
op ctz.i lat 2 thr 1
op bswap.i lat 2 thr 1
op trunc.i lat 0 thr 1
op zext.i lat 0 thr 1
op sext.i lat 1 thr 1
op select.i lat 3 thr 1
op fadd.f lat 4 thr 1
op fsub.f lat 4 thr 1
op fmul.f lat 4 thr 1
op fdiv.f lat 16 thr 8
op fneg.f lat 1 thr 1
op fabs.f lat 1 thr 1
op fma.f lat 4 thr 1
op fcmp.f lat 3 thr 1
op fcmp.i lat 3 thr 1
op ftrunc.f lat 3 thr 1
op fext.f lat 2 thr 1
op fptosi.i lat 5 thr 2
op fptoui.i lat 5 thr 2
op sitofp.f lat 5 thr 2
op uitofp.f lat 5 thr 2
op bitcast.i lat 2 thr 1
op alloca.i lat 0 thr 1
op load.i lat 4 thr 1
op loadv.i lat 4 thr 1
op store.i lat 1 thr 1
op storev.i lat 1 thr 1
op gep.i lat 1 thr 1
op memcpy.i lat 30 thr 10
op memset.i lat 30 thr 10
op aload.i lat 6 thr 2
op astore.i lat 2 thr 1
op fence.i lat 10 thr 5
op aadd.i lat 16 thr 8
op acmpxchg.i lat 24 thr 12
op axchg.i lat 16 thr 8
op asub.i lat 16 thr 8
op aand.i lat 16 thr 8
op aor.i lat 16 thr 8
op axor.i lat 16 thr 8
op amins.i lat 16 thr 8
op amaxs.i lat 16 thr 8
op aminu.i lat 16 thr 8
op amaxu.i lat 16 thr 8
op vsplat.v lat 8 thr 4
op vadd.v lat 12 thr 6
op vsub.v lat 12 thr 6
op vmul.v lat 16 thr 8
op vudiv.v lat 120 thr 60 cliff 1
op vfadd.v lat 20 thr 10
op vfsub.v lat 20 thr 10
op vfmul.v lat 20 thr 10
op vfdiv.v lat 80 thr 40 cliff 1
op vand.v lat 12 thr 6
op vor.v lat 12 thr 6
op vxor.v lat 12 thr 6
op vlshr.v lat 12 thr 6
op vload.v lat 12 thr 6
op vstore.v lat 8 thr 4
op vextract.i lat 3 thr 1
op vinsert.v lat 10 thr 5
fn memcpy cost 30
fn memset cost 30
fn fma cost 4
fn fmaf cost 4
# i128 width rows (v3.0): memory-resident lowering; division gated off.
op add.i128 lat 2 thr 1
op sub.i128 lat 2 thr 1
op mul.i128 lat 7 thr 1
op neg.i128 lat 2 thr 1
op and.i128 lat 2 thr 1
op or.i128 lat 2 thr 1
op xor.i128 lat 2 thr 1
op not.i128 lat 2 thr 1
op shl.i128 lat 6 thr 1
op lshr.i128 lat 6 thr 1
op ashr.i128 lat 7 thr 1
op icmp.i128 lat 3 thr 1
op popcount.i128 lat 4 thr 1
op clz.i128 lat 5 thr 1
op ctz.i128 lat 5 thr 1
op bswap.i128 lat 4 thr 1
op trunc.i128 lat 1 thr 1
op zext.i128 lat 1 thr 1
op sext.i128 lat 2 thr 1
op freeze.i128 lat 1 thr 1
op load.i128 lat 5 thr 1
op store.i128 lat 2 thr 1
op udiv.i128 lat 40 thr 1 cliff 1
op sdiv.i128 lat 44 thr 1 cliff 1
op urem.i128 lat 40 thr 1 cliff 1
op srem.i128 lat 44 thr 1 cliff 1
op funcptr.i lat 1 thr 1
